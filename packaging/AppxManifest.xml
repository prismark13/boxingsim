<?xml version="1.0" encoding="utf-8"?>

<!--
  The MSIX manifest for the Microsoft Store.

  Why this exists at all: an unsigned executable handed to somebody is met by SmartScreen ("Windows
  protected your PC") and, on a clean Windows 11 install with Smart App Control enabled, may simply refuse
  to start with no way through — which is exactly what happens on the development machine. Signing that
  away costs $220-580 a year for an EV certificate, or $120 a year for Azure Trusted Signing, whose
  individual-developer route is presently shut.

  A Store package sidesteps all of it: Microsoft signs the package, so there is no warning to click through
  and nothing for Smart App Control to object to. Individual developer registration became free in
  September 2025.

  The identity below is the real one, issued by Partner Center for The Final Bell (Store ID 9P3B0VK4TBNX)
  and copied verbatim from its Product identity page. It must match exactly or certification rejects the
  package, which is the single most common reason a first submission fails. If the product is ever
  recreated in Partner Center, these values change and must be copied again.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Prismark.TheFinalBell"
    Publisher="CN=6D48472E-F6B3-45EB-9398-938A34F4C879"
    Version="0.6.4.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>The Final Bell</DisplayName>
    <PublisherDisplayName>Prismark</PublisherDisplayName>
    <Logo>assets\store\StoreLogo.png</Logo>
    <Description>A boxing career simulator. Take a fighter from his debut to the Hall of Fame, or watch a whole sport run without you.</Description>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809 is the floor for .NET desktop apps in MSIX. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="TheFinalBell" Executable="BoxingSim.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="The Final Bell"
        Description="A boxing career simulator: fights called round by round, a world that moves without you, and a Hall of Fame at the end of it."
        BackgroundColor="#14110F"
        Square150x150Logo="assets\store\Square150x150Logo.png"
        Square44x44Logo="assets\store\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="assets\store\Wide310x150Logo.png"
          Square310x310Logo="assets\store\Square310x310Logo.png"
          Square71x71Logo="assets\store\Square71x71Logo.png" />
        <uap:SplashScreen Image="assets\store\SplashScreen.png" BackgroundColor="#14110F" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A full-trust desktop app. The sim needs nothing else: no network, no camera, no location. It reads
         its roster from resources embedded in the executable and writes one save file to the user's own
         app-data folder, both of which this capability already covers. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
