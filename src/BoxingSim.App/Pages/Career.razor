@page "/career"
@inject CareerService Svc
@inject Microsoft.JSInterop.IJSRuntime Js

<PageTitle>Career</PageTitle>

@if (!Svc.HasCareer)
{
    <div class="setup">
        @if (_hasSave)
        {
            <button class="primary" @onclick="Continue"><Icon Name="play" Size="15" /> Continue saved career</button>
            <div class="muted orsep">— or start a new one (replaces your save) —</div>
        }
        <div class="eyebrow">Career mode</div>
        <h1>Create a fighter</h1>
        <p>Steer a heavyweight from club shows to a shot at the world title, in a living division where the real greats debut around you.</p>

        @{ var pickable = _divisions.Where(d => d.FoundedYear() <= _year).OrderByDescending(d => (int)d).ToList(); }
        @if (pickable.Count > 1)
        {
            <div class="label">Division</div>
            <select value="@_division" @onchange="e => _division = Enum.Parse<WeightClass>(e.Value!.ToString()!)">
                @foreach (var d in pickable) { <option value="@d">@d.DisplayName() · @WeightText(d)</option> }
            </select>
        }

        <div class="label">Country</div>
        <select value="@_country" @onchange="OnCountryChanged">
            @foreach (var c in _countries) { <option value="@c">@c</option> }
        </select>

        <div class="label">Fighter name</div>
        <div class="namerow">
            <input value="@_name" @oninput="e => _name = e.Value?.ToString() ?? string.Empty" placeholder="Fighter name" />
            <button type="button" class="ghost icon-btn" @onclick="RollName" title="Random name"><Icon Name="refresh" Size="16" /></button>
        </div>

        <div class="label">Start year</div>
        <select value="@_year" @onchange="e => _year = int.Parse(e.Value!.ToString()!)">
            @foreach (var y in _years) { <option value="@y">@y</option> }
        </select>

        <div class="label">Talent · prime ceiling</div>
        <select @bind="_talent">
            <option value="elite">World-beater · prime class 13–15</option>
            <option value="contender">Contender · prime class 9–12</option>
            <option value="journeyman">Journeyman · prime class 5–8</option>
            <option value="club">Club fighter · prime class ≤5</option>
            <option value="random915">Pot luck · random class 9–15</option>
        </select>

        <button class="primary" @onclick="StartAsync" disabled="@_busy">
            @if (_busy) { <text>Setting up…</text> } else { <text>Turn pro</text><Icon Name="arrow" Size="15" /> }
        </button>
    </div>
}
else
{
    var g = Svc.Game!;
    var p = g.Player;
    var stage = CareerStages.Of(p);
    // A fighter only enters the rankings once he's earned it (20 pro bouts). The player isn't special —
    // he shows as "NR" until then, so a 9-fight prospect never carries a world ranking.
    var ranked = g.Active.Where(CareerGame.WorldRanked).Where(b => b.Record.Wins + 3 >= b.Record.Losses || b.Id == p.Id).OrderByDescending(CareerGame.RankScore).ToList();
    int rank = ranked.FindIndex(b => b.Id == p.Id) + 1;   // 0 (→ "–") until he's world-ranked
    int pFights = p.Record.Wins + p.Record.Losses + p.Record.Draws;

    // One clickable ledger row, shared by the fighter card and the career profile. Click to drill in.
    RenderFragment<BoutLine> boutRow = bt =>
        @<div class="tl clickable" @onclick="() => _bout = bt">
            <span class="rw @(bt.Result == 'W' ? "win" : bt.Result == 'L' ? "loss" : "draw")">@bt.Result</span>
            <span class="tly">@bt.Date.ToString("d MMM yy")</span>
            @bt.Opponent
            @if (bt.Note is not null) { <span class="fnote @(IsWorldNote(bt.Note) ? "world" : "")">@bt.Note</span> }
            <span class="muted"> · @bt.Method@((bt.Method == "KO" || bt.Method == "TKO") ? $" rd{bt.Round}" : "")@(bt.KdFor + bt.KdAgainst > 0 ? $" · KD {bt.KdFor}-{bt.KdAgainst}" : "")</span>
        </div>;

    Func<string, IReadOnlyList<AwardWinner>, RenderFragment> AwardCat = (title, list) =>
        @<text>
            @if (list.Count > 0)
            {
                <div class="label" style="margin:10px 0 4px;">@title</div>
                var ar = 1;
                @foreach (var w in list)
                {
                    <div class="rkrow"><span class="rkn @(ar == 1 ? "" : "nr")">@ar</span><span class="rkname">@w.Name <span class="champ-tag torank">@w.Div.DisplayName()</span></span><span class="rkrec muted">@w.Detail</span></div>
                    ar++;
                }
            }
        </text>;

    <div class="career-top">
        <div class="pident">
            <div class="ovrpill big" style="color:@Ui.Ovr(p.Class)">@p.Class</div>
            <div>
                <div class="pname">
                    @p.Name
                    @foreach (var belt in PlayerBelts(g)) { <span class="badge-champ"><Icon Name="trophy" Size="12" /> @belt</span> }
                </div>
                <div class="pmeta">
                    <span class="cc">@Ui.Code(p.Country)</span> · age @p.Age · <span class="stage-pill">@CareerStages.Label(stage)</span> · @p.Record · #@(rank > 0 ? rank.ToString() : "–")
                </div>
            </div>
        </div>
        <div class="yearbox"><span class="label">Date</span><b class="datebig">@g.DateLabel</b></div>
        <div class="savebox">
            <span class="saved">Auto-saved</span>
            <div class="savebtns">
                <button class="ghost" @onclick="() => _profile = true">My fighter</button>
                <button class="ghost" @onclick="NewCareer">New career</button>
            </div>
        </div>
    </div>

    <div class="career-grid">
        <div class="col">
            @if (g.PlayerInjury is Injury pi)
            {
                <div class="recovering"><span class="tag injury">Injured</span> Recovering from @pi.Type — cleared to fight @g.OfferDateLabel.</div>
            }
            @if (g.Offer is FightOffer offer)
            {
                <div class="offer @(offer.TitleFight ? "title" : "")">
                    <div class="offer-h">
                        @if (offer.TitleFight) { <Icon Name="trophy" Size="13" /> }
                        Fight night · @g.OfferDateLabel@(string.IsNullOrEmpty(offer.Context) ? "" : $" · {offer.Context}")
                    </div>
                    <div class="opp">
                        <div class="ovrpill" style="color:@Ui.Ovr(offer.Opponent.Class)">@offer.Opponent.Class</div>
                        <div>
                            <div class="oname">@offer.Opponent.Name</div>
                            <div class="osub"><span class="cc">@Ui.Code(offer.Opponent.Country)</span>@StyleClassifier.Of(offer.Opponent).DisplayName() · @offer.Opponent.Record · @offer.Rounds rounds</div>
                        </div>
                    </div>
                    <div class="offer-btns">
                        <button class="primary" @onclick="Take">Take the fight</button>
                        <button @onclick="Decline">Hold out</button>
                    </div>
                </div>
            }
            else
            {
                <div class="offer over">
                    <div class="offer-h">Career over</div>
                    <p class="muted">@p.Name retired in @g.Year, aged @p.Age, with a record of <b>@p.Record</b>.</p>
                    <button class="primary" @onclick="NewCareer">Start a new career</button>
                </div>
            }

            @if (g.Unified && g.Champion?.Id == p.Id)
            {
                <div class="undisputed-bar">
                    <span><Icon Name="trophy" Size="12" /> Undisputed — both world belts ride on every defence.</span>
                    <button class="ghost sm" @onclick="RelinquishWbc">Relinquish WBC</button>
                </div>
            }
            @if (g.CanMoveUp)
            {
                <div class="moveup-bar">
                    <span>@p.WeightClass.DisplayName() · @WeightText(p.WeightClass)</span>
                    <button class="ghost sm" @onclick="MoveUp">Move up to @g.NextDivision!.Value.DisplayName()</button>
                </div>
            }

            @if (Svc.LastResult is FightResult res)
            {
                <div class="resultbox @(Won(res) ? "win" : res.IsDraw ? "draw" : "loss")">
                    <div class="rhead">@ResultWord(res)</div>
                    <div class="rline">@res.Headline()</div>
                    @if (res.War) { <div class="rnote"><span class="tag">War</span> Both men left everything in the ring.</div> }
                    @foreach (var inj in res.Injuries) { <div class="rnote"><span class="tag injury">Injury</span> @inj.Name — @inj.Type (@inj.LayoffDays days out)</div> }
                    @foreach (var le in res.Lasting) { <div class="rnote"><span class="tag wear">Wear</span> @le.Name — @le.Note</div> }
                </div>
            }

            <div class="panel newsfeed-panel">
                <div class="panel-h">
                    <span><Icon Name="bolt" Size="13" /> News</span>
                    <select class="newsfilter" @bind="_newsFilter">
                        <option value="">@g.Division.DisplayName()</option>
                        <option value="all">All divisions</option>
                        @foreach (var wc in g.LiveDivisions) { <option value="@wc">@wc.DisplayName()</option> }
                    </select>
                </div>
                <div class="timeline-body newsfeed">
                    @foreach (var e in NewsEvents(g))
                    {
                        <div class="news @(e.PlayerBout ? "mine" : "") k-@(e.Kind ?? "note")">
                            <span class="tly">@e.DateLabel</span>
                            @if (e.PlayerBout || e.Kind is not null) { <span class="ntag">@NewsTag(e)</span> }
                            @if (e.Div is WeightClass ed && ed != g.Division) { <span class="ndiv">@ed.DisplayName()</span> }
                            <span class="ntext">@e.Text</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col">
            <div class="panel">
                <div class="rank-tabs">
                    <button class="@(_rankTab == "world" ? "on" : "")" @onclick='() => _rankTab = "world"'>Rankings</button>
                    <button class="@(_rankTab == "p4p" ? "on" : "")" @onclick='() => _rankTab = "p4p"'>Pound-for-pound</button>
                    <button class="@(_rankTab == "sport" ? "on" : "")" @onclick='() => _rankTab = "sport"'>Divisions</button>
                    <button class="@(_rankTab == "hof" ? "on" : "")" @onclick='() => _rankTab = "hof"'>Hall of Fame</button>
                    <button class="@(_rankTab == "awards" ? "on" : "")" @onclick='() => _rankTab = "awards"'>Awards</button>
                </div>

                @if (_rankTab == "world")
                {
                    <div class="panel-sub">@g.Division.DisplayName() · @g.ActiveCount active · @g.UniverseSize all-time</div>
                    @if (g.Champion is Boxer champ)
                    {
                        <div class="rkrow champ-row @(champ.Id == p.Id ? "me" : "")" @onclick="() => _selected = champ">
                            <span class="rkn"><Icon Name="trophy" Size="13" /></span>
                            <span class="ovrpill" style="color:@Ui.Ovr(champ.Class)">@champ.Class</span>
                            <span class="rkname">@champ.Name @foreach (var bt in g.BeltsHeld(champ)) { <span class="champ-tag">@BeltLabel(bt)</span> }</span>
                            <span class="rkrec">@champ.Record</span>
                        </div>
                    }
                    @if (g.WbcChampion is Boxer wbc && wbc.Id != g.Champion?.Id)
                    {
                        <div class="rkrow champ-row @(wbc.Id == p.Id ? "me" : "")" @onclick="() => _selected = wbc">
                            <span class="rkn"><Icon Name="trophy" Size="13" /></span>
                            <span class="ovrpill" style="color:@Ui.Ovr(wbc.Class)">@wbc.Class</span>
                            <span class="rkname">@wbc.Name @foreach (var bt in g.BeltsHeld(wbc)) { <span class="champ-tag">@BeltLabel(bt)</span> }</span>
                            <span class="rkrec">@wbc.Record</span>
                        </div>
                    }
                    @if (g.IbfChampion is Boxer ibf && ibf.Id != g.Champion?.Id && ibf.Id != g.WbcChampion?.Id)
                    {
                        <div class="rkrow champ-row @(ibf.Id == p.Id ? "me" : "")" @onclick="() => _selected = ibf">
                            <span class="rkn"><Icon Name="trophy" Size="13" /></span>
                            <span class="ovrpill" style="color:@Ui.Ovr(ibf.Class)">@ibf.Class</span>
                            <span class="rkname">@ibf.Name @foreach (var bt in g.BeltsHeld(ibf)) { <span class="champ-tag">@BeltLabel(bt)</span> }</span>
                            <span class="rkrec">@ibf.Record</span>
                        </div>
                    }
                    int r = 1;
                    @foreach (var b in ranked.Where(b => b.Id != g.Champion?.Id && b.Id != g.WbcChampion?.Id && b.Id != g.IbfChampion?.Id).Take(15))
                    {
                        <div class="rkrow @(b.Id == p.Id ? "me" : "")" @onclick="() => _selected = b">
                            <span class="rkn">@r</span>
                            <span class="ovrpill" style="color:@Ui.Ovr(b.Class)">@b.Class</span>
                            <span class="rkname">@b.Name</span>
                            <span class="rkrec">@b.Record</span>
                        </div>
                        r++;
                    }
                    @if (rank == 0)
                    {
                        <div class="rkrow me" @onclick="() => _selected = p">
                            <span class="rkn nr">NR</span>
                            <span class="ovrpill" style="color:@Ui.Ovr(p.Class)">@p.Class</span>
                            <span class="rkname">@p.Name <span class="champ-tag torank">@(20 - pFights) to rank</span></span>
                            <span class="rkrec">@p.Record</span>
                        </div>
                    }
                    var homeProspects = g.ProspectsOf(g.Division);
                    @if (homeProspects.Count > 0)
                    {
                        <div class="panel-h" style="margin-top:14px;">Top prospects <span class="muted">· the up-and-comers</span></div>
                        @foreach (var b in homeProspects)
                        {
                            <div class="rkrow @(b.Id == p.Id ? "me" : "")" @onclick="() => _selected = b"><span class="rkn nr">P</span><span class="ovrpill" style="color:@Ui.Ovr(b.Class)">@b.Class</span><span class="rkname">@b.Name <span class="champ-tag torank">age @b.Age</span></span><span class="rkrec">@b.Record</span></div>
                        }
                    }
                }
                else if (_rankTab == "p4p")
                {
                    <div class="panel-sub">Pound-for-pound · every division</div>
                    int pp = 1;
                    @foreach (var b in g.PoundForPound(15))
                    {
                        <div class="rkrow @(b.Id == p.Id ? "me" : "")" @onclick="() => _selected = b">
                            <span class="rkn">@pp</span>
                            <span class="ovrpill" style="color:@Ui.Ovr(b.Class)">@b.Class</span>
                            <span class="rkname">@b.Name @if (g.IsWorldChampion(b)) { <span class="champ-tag"><Icon Name="trophy" Size="10" /> champ</span> } <span class="champ-tag torank">@b.WeightClass.DisplayName()</span></span>
                            <span class="rkrec">@b.Record</span>
                        </div>
                        pp++;
                    }
                }
                else if (_rankTab == "hof")
                {
                    <div class="panel-sub">Hall of Fame · @g.HallOfFame.Count inducted</div>
                    @if (g.HallOfFame.Count == 0)
                    {
                        <div class="muted" style="padding:12px 4px;">No inductees yet — the greats are still active. Champions enter the Hall when they retire.</div>
                    }
                    int hf = 1;
                    @foreach (var m in g.HallOfFame)
                    {
                        <div class="rkrow" @onclick="() => _hofSel = m">
                            <span class="rkn"><Icon Name="trophy" Size="12" /></span>
                            <span class="ovrpill" style="color:@Ui.Ovr(m.PeakClass)">@m.PeakClass</span>
                            <span class="rkname">@m.Name @if (m.WeightTitles >= 2) { <span class="champ-tag">@(m.WeightTitles)-weight champ</span> } else if (m.WasChampion) { <span class="champ-tag">World champ</span> } <span class="champ-tag torank">@m.Division.DisplayName()@(m.Defenses > 0 ? $" · {m.Defenses} def" : "")</span></span>
                            <span class="rkrec">@m.Record</span>
                        </div>
                        hf++;
                    }
                }
                else if (_rankTab == "awards")
                {
                    <div class="panel-sub">Annual awards · end-of-year honours</div>
                    @if (g.Awards.Count == 0)
                    {
                        <div class="muted" style="padding:12px 4px;">No awards yet — they're handed out at the end of each year.</div>
                    }
                    @foreach (var yr in g.Awards)
                    {
                        <div class="panel-h" style="margin-top:14px;">@yr.Year</div>
                        @AwardCat("Fighter of the Year", yr.FighterOfYear)
                        @AwardCat("Fight of the Year", yr.FightOfYear)
                        @AwardCat("Knockout of the Year", yr.KnockoutOfYear)
                        @AwardCat("Upset of the Year", yr.UpsetOfYear)
                    }
                }
                else
                {
                    <div class="panel-sub">Across the sport · tap a division for its rankings</div>
                    @foreach (var wc in g.LiveDivisions)
                    {
                        var dc = g.WorldChampionOf(wc);
                        <div class="divrow @(wc == g.Division ? "here" : "")" @onclick="() => _viewDiv = wc">
                            <span class="divn">@wc.DisplayName()</span>
                            <span class="divc">@(dc?.Name ?? "vacant")</span>
                            <span class="divx">@g.ActiveCountOf(wc)</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @if (_viewDiv is WeightClass vd)
    {
        <div class="modal-bg" @onclick="() => _viewDiv = null">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <div><div class="pname">@vd.DisplayName()</div><div class="pmeta">World ranking · @g.ActiveCountOf(vd) active</div></div>
                    <button class="ghost icon-btn" @onclick="() => _viewDiv = null"><Icon Name="close" Size="16" /></button>
                </div>
                @{ var beltHolders = new (string Belt, Boxer? B)[] { (g.PrimaryBelt, g.WorldChampionOf(vd)), ("WBC", g.WbcChampionOf(vd)), ("IBF", g.IbfChampionOf(vd)) };
                   var champRows = beltHolders.Where(x => x.B is not null).Select(x => x.B!).DistinctBy(b => b.Id).ToList(); }
                @foreach (var vc in champRows)
                {
                    <div class="rkrow champ-row" @onclick="() => _selected = vc"><span class="rkn"><Icon Name="trophy" Size="13" /></span><span class="ovrpill" style="color:@Ui.Ovr(vc.Class)">@vc.Class</span><span class="rkname">@vc.Name @foreach (var bt in g.BeltsHeld(vc)) { <span class="champ-tag">@BeltLabel(bt)</span> }</span><span class="rkrec">@vc.Record</span></div>
                }
                @{ int vr = 1; var champIds = champRows.Select(b => b.Id).ToHashSet(); }
                @foreach (var b in g.RankingOf(vd).Where(b => !champIds.Contains(b.Id)))
                {
                    <div class="rkrow"><span class="rkn">@vr</span><span class="ovrpill" style="color:@Ui.Ovr(b.Class)">@b.Class</span><span class="rkname">@b.Name</span><span class="rkrec">@b.Record</span></div>
                    vr++;
                }
                @{ var prospects = g.ProspectsOf(vd); }
                @if (prospects.Count > 0)
                {
                    <div class="panel-h" style="margin-top:14px;">Top prospects</div>
                    @foreach (var b in prospects)
                    {
                        <div class="rkrow"><span class="rkn nr">P</span><span class="ovrpill" style="color:@Ui.Ovr(b.Class)">@b.Class</span><span class="rkname">@b.Name <span class="champ-tag torank">age @b.Age</span></span><span class="rkrec">@b.Record</span></div>
                    }
                }
            </div>
        </div>
    }

    @if (_hofSel is HallOfFamer hm)
    {
        <div class="modal-bg" @onclick="() => _hofSel = null">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <div class="ovrpill big" style="color:@Ui.Ovr(hm.PeakClass)">@hm.PeakClass</div>
                    <div>
                        <div class="pname">@hm.Name <span class="badge-champ"><Icon Name="trophy" Size="12" /> Hall of Fame</span></div>
                        <div class="pmeta"><span class="cc">@Ui.Code(hm.Country)</span> · @hm.Division.DisplayName() · @hm.Record</div>
                    </div>
                    <button class="ghost icon-btn" @onclick="() => _hofSel = null"><Icon Name="close" Size="16" /></button>
                </div>
                <div class="hof-facts">
                    @if (hm.WeightTitles >= 2) { <span class="champ-tag">@(hm.WeightTitles)-weight world champion</span> }
                    else if (hm.WasChampion) { <span class="champ-tag">World champion</span> }
                    @if (hm.Defenses > 0) { <span class="champ-tag torank">@hm.Defenses title defence@(hm.Defenses == 1 ? "" : "s")</span> }
                    <span class="champ-tag torank">peak class @hm.PeakClass</span>
                    <span class="champ-tag torank">inducted @hm.Year · retired at @hm.Age</span>
                </div>
                @if (hm.History.Count > 0)
                {
                    <div class="label" style="margin:14px 0 8px;">Fight history (@hm.History.Count)</div>
                    <div class="history">
                        @foreach (var bt in hm.History.OrderByDescending(h => h.Date)) { @boutRow(bt) }
                    </div>
                }
                else
                {
                    <div class="muted" style="padding:10px 4px;">Fight-by-fight history wasn't recorded for this inductee.</div>
                }
            </div>
        </div>
    }

    @if (_selected is Boxer sel)
    {
        <div class="modal-bg" @onclick="() => _selected = null">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <div class="ovrpill big" style="color:@Ui.Ovr(sel.Class)">@sel.Class</div>
                    <div>
                        <div class="pname">@sel.Name @if (sel.IsChampion) { <span class="badge-champ"><Icon Name="trophy" Size="12" /> Champion</span> }</div>
                        <div class="pmeta"><span class="cc">@Ui.Code(sel.Country)</span> · @StyleClassifier.Of(sel).DisplayName() · @sel.Record</div>
                    </div>
                    <button class="ghost icon-btn" @onclick="() => _selected = null"><Icon Name="close" Size="16" /></button>
                </div>
                <div class="stage-row">
                    <span class="label">Career stage</span>
                    <span class="stage-pill">@CareerStages.Label(CareerStages.Of(sel))</span>
                    <span class="muted">· age @sel.Age</span>
                </div>
                <div class="stage-row">
                    <span class="label">Division</span>
                    <span class="stage-pill">@sel.WeightClass.DisplayName()</span>
                    <span class="muted">· @(sel.WeightClass.WeightLimitLbs() >= 999 ? "unlimited" : sel.WeightClass.WeightLimitLbs() + " lb")@(sel.Reach > 0 ? $" · {sel.Reach}\" reach" : "")@(sel.TopWeight is WeightClass tw && tw != sel.WeightClass ? $" · rises to {tw.DisplayName()}" : "")</span>
                </div>
                @{ var selBelts = g.BeltsHeld(sel).ToList(); }
                @if (selBelts.Count > 0)
                {
                    <div class="stage-row">
                        <span class="label">Titles</span>
                        @foreach (var bt in selBelts) { <span class="champ-tag">@BeltLabel(bt)</span> }
                    </div>
                }
                <div class="label" style="margin-bottom:8px;">Attributes</div>
                <div class="tiles2">
                    @foreach (var (k, v) in Stats(sel))
                    {
                        <div class="stat"><span class="k">@k</span><span class="v" style="color:@Ui.Ovr(v)">@v</span></div>
                    }
                </div>
                <div class="label" style="margin:14px 0 8px;">Secondary ratings</div>
                <div class="tiles2">
                    @foreach (var (k, v) in Secondary(sel))
                    {
                        <div class="stat sec"><span class="k">@k</span><span class="v" style="color:@Ui.Ovr(v)">@v</span></div>
                    }
                </div>
                <div class="label" style="margin:14px 0 8px;">Punch arsenal</div>
                <div class="mixbar">
                    @foreach (var (name, pct) in Arsenal(sel)) { <span class="mixseg" style="width:@pct%;background:@ArsenalColor(name)" title="@name @pct%"></span> }
                </div>
                <div class="mixlegend">
                    @foreach (var (name, pct) in Arsenal(sel)) { <span class="mixk"><i style="background:@ArsenalColor(name)"></i>@name @pct%</span> }
                </div>
                @if (sel.History.Count > 0)
                {
                    <div class="label" style="margin:14px 0 8px;">Fight history (@sel.History.Count)</div>
                    <div class="history">
                        @foreach (var bt in sel.History.OrderByDescending(h => h.Date)) { @boutRow(bt) }
                    </div>
                }
            </div>
        </div>
    }

    @if (_playback is FightResult pb)
    {
        <div class="modal-bg">
            <div class="fs-modal"><FightScreen Result="pb" OnComplete="() => _playback = null" /></div>
        </div>
    }

    @if (_bout is BoutLine bd)
    {
        <div class="modal-bg" @onclick="() => _bout = null">
            <div class="modal narrow" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <div class="ovrpill big @(bd.Result == 'W' ? "win" : bd.Result == 'L' ? "loss" : "draw")">@bd.Result</div>
                    <div>
                        <div class="pname">vs @bd.Opponent</div>
                        <div class="pmeta">@bd.Date.ToString("d MMM yyyy")@(bd.Note is not null ? $" · {bd.Note}" : "")</div>
                    </div>
                    <button class="ghost icon-btn" @onclick="() => _bout = null"><Icon Name="close" Size="16" /></button>
                </div>
                <div class="tiles2">
                    <div class="stat"><span class="k">RESULT</span><span class="v">@ResultLong(bd)</span></div>
                    <div class="stat"><span class="k">METHOD</span><span class="v">@bd.Method</span></div>
                    <div class="stat"><span class="k">END ROUND</span><span class="v">@bd.Round</span></div>
                    <div class="stat"><span class="k">KNOCKDOWNS</span><span class="v">@bd.KdFor-@bd.KdAgainst</span></div>
                </div>
                @if (bd.Rounds is { Count: > 0 } rounds)
                {
                    var lf = rounds.Sum(r => r.LandedFor);
                    var la = rounds.Sum(r => r.LandedAgainst);
                    var scoreFor = rounds.Sum(r => r.ScoreFor);
                    var scoreAg = rounds.Sum(r => r.ScoreAgainst);
                    bool stopped = bd.Method is "KO" or "TKO";
                    <div class="label" style="margin:16px 0 8px;">Punches landed</div>
                    <div class="tiles2">
                        <div class="stat"><span class="k">@Surname(p.Name)</span><span class="v">@lf</span></div>
                        <div class="stat"><span class="k">@Surname(bd.Opponent)</span><span class="v">@la</span></div>
                    </div>
                    <div class="label" style="margin:16px 0 8px;">
                        Scorecard by round
                        @if (stopped) { <span class="muted">· to the stoppage in rd @bd.Round</span> }
                    </div>
                    <div class="rounds-tbl">
                        <div class="rtr rth"><span>Rd</span><span>You</span><span>Opp</span><span>Card</span></div>
                        @foreach (var rd in rounds)
                        {
                            <div class="rtr @(rd.ScoreFor > rd.ScoreAgainst ? "won" : rd.ScoreFor < rd.ScoreAgainst ? "lost" : "")">
                                <span>@rd.Round</span>
                                <span>@rd.LandedFor</span>
                                <span>@rd.LandedAgainst</span>
                                <span class="rcard">@rd.ScoreFor–@rd.ScoreAgainst@if (rd.KdFor > 0) { <b class="kd for">@rd.KdFor KD</b>} @if (rd.KdAgainst > 0) { <b class="kd against">@rd.KdAgainst KD</b>}</span>
                            </div>
                        }
                        <div class="rtr rtf"><span>@(stopped ? "≈" : "Σ")</span><span>@lf</span><span>@la</span><span class="rcard">@scoreFor–@scoreAg</span></div>
                    </div>
                    @if (!string.IsNullOrEmpty(bd.Cards))
                    {
                        <div class="label" style="margin:16px 0 8px;">Official scorecards</div>
                        <div class="cards">
                            @foreach (var c in bd.Cards!.Split(" · ")) { <span class="cardchip">@c</span> }
                        </div>
                        <div class="muted" style="margin-top:8px;">Shown from @p.Name's corner.</div>
                    }
                    else if (stopped)
                    {
                        <div class="muted" style="margin-top:8px;">Ended inside the distance, so it never reached the official cards — the row marked ≈ is how it was running.</div>
                    }
                }
                else if (!string.IsNullOrEmpty(bd.Cards))
                {
                    <div class="label" style="margin:14px 0 8px;">Judges' scorecards</div>
                    <div class="cards">
                        @foreach (var c in bd.Cards!.Split(" · ")) { <span class="cardchip">@c</span> }
                    </div>
                    <div class="muted" style="margin-top:8px;">Shown from @p.Name's corner.</div>
                }
                else
                {
                    <div class="muted" style="margin-top:12px;">@(bd.Method is "KO" or "TKO" ? $"Ended by {bd.Method} in round {bd.Round}." : $"Result by {bd.Method}.") No round-by-round card was kept for this bout.</div>
                }

                @if (bd.Commentary is { Count: > 0 } comm)
                {
                    <div class="label" style="margin:16px 0 8px;">Commentary</div>
                    <div class="commentary">
                        @foreach (var line in comm)
                        {
                            <div class="cline @(line.Contains("DOWN") || line.Contains("KNOCKS") || line.Contains("STOPS") || line.Contains("hurt") ? "big" : line.Contains(" · ") ? "recap" : "")">@line</div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (_profile)
    {
        <div class="modal-bg" @onclick="() => _profile = false">
            <div class="modal wide" @onclick:stopPropagation="true">
                <div class="modal-head">
                    <div class="ovrpill big" style="color:@Ui.Ovr(p.Class)">@p.Class</div>
                    <div>
                        <div class="pname">@p.Name @if (p.IsChampion) { <span class="badge-champ"><Icon Name="trophy" Size="12" /> Champion</span> }</div>
                        <div class="pmeta"><span class="cc">@Ui.Code(p.Country)</span> · @StyleClassifier.Of(p).DisplayName() · @CareerStages.Label(stage) · age @p.Age</div>
                    </div>
                    <button class="ghost icon-btn" @onclick="() => _profile = false"><Icon Name="close" Size="16" /></button>
                </div>
                <div class="tiles2">
                    <div class="stat"><span class="k">RECORD</span><span class="v">@p.Record.Wins-@p.Record.Losses-@p.Record.Draws</span></div>
                    <div class="stat"><span class="k">KO WINS</span><span class="v">@p.Record.KnockoutWins</span></div>
                    <div class="stat"><span class="k">KO %</span><span class="v">@(p.Record.Wins > 0 ? 100 * p.Record.KnockoutWins / p.Record.Wins : 0)</span></div>
                    <div class="stat"><span class="k">RANK</span><span class="v">#@(rank > 0 ? rank.ToString() : "–")</span></div>
                    <div class="stat"><span class="k">BOUTS</span><span class="v">@(p.Record.Wins + p.Record.Losses + p.Record.Draws)</span></div>
                    <div class="stat"><span class="k">DIVISION</span><span class="v">@p.WeightClass.DisplayName()</span></div>
                    @if (p.Reach > 0) { <div class="stat"><span class="k">REACH</span><span class="v">@p.Reach"</span></div> }
                </div>
                <div class="label" style="margin:15px 0 8px;">Attributes</div>
                <div class="tiles2">
                    @foreach (var (k, v) in Stats(p))
                    {
                        <div class="stat"><span class="k">@k</span><span class="v" style="color:@Ui.Ovr(v)">@v</span></div>
                    }
                </div>
                <div class="label" style="margin:14px 0 8px;">Secondary ratings</div>
                <div class="tiles2">
                    @foreach (var (k, v) in Secondary(p))
                    {
                        <div class="stat sec"><span class="k">@k</span><span class="v" style="color:@Ui.Ovr(v)">@v</span></div>
                    }
                </div>
                <div class="label" style="margin:14px 0 8px;">Punch arsenal</div>
                <div class="mixbar">
                    @foreach (var (name, pct) in Arsenal(p)) { <span class="mixseg" style="width:@pct%;background:@ArsenalColor(name)" title="@name @pct%"></span> }
                </div>
                <div class="mixlegend">
                    @foreach (var (name, pct) in Arsenal(p)) { <span class="mixk"><i style="background:@ArsenalColor(name)"></i>@name @pct%</span> }
                </div>
                @if (g.Reigns.Count > 0)
                {
                    <div class="label" style="margin:15px 0 8px;">World title</div>
                    <div class="reigns">
                        <div class="reign-summary">
                            <span class="badge-champ"><Icon Name="trophy" Size="12" /> @g.Reigns.Count reign@(g.Reigns.Count == 1 ? "" : "s")</span>
                            @g.TitleDefenses defence@(g.TitleDefenses == 1 ? "" : "s") · @(g.DaysAsChampion / 30) months as champion
                        </div>
                        @foreach (var reign in g.Reigns)
                        {
                            <div class="tl"><span class="champ-tag">@reign.Belt</span> <span class="tly">@reign.Won.ToString("MMM yyyy")</span> – @(reign.Lost is null ? "present" : reign.Lost.Value.ToString("MMM yyyy")) · @reign.Defenses defence@(reign.Defenses == 1 ? "" : "s")</div>
                        }
                    </div>
                }
                <div class="label" style="margin:15px 0 8px;">Fight history (@p.History.Count) <span class="muted">· tap a bout for the card</span></div>
                <div class="history">
                    @if (p.History.Count == 0) { <div class="muted">No fights yet.</div> }
                    @foreach (var bt in p.History.OrderByDescending(h => h.Date)) { @boutRow(bt) }
                </div>
            </div>
        </div>
    }
}

@code {
    private Boxer? _selected;
    private BoutLine? _bout;
    private FightResult? _playback;
    private WeightClass? _viewDiv;
    private HallOfFamer? _hofSel;
    private string _newsFilter = "";
    private string _rankTab = "world";
    private bool _profile;

    private IEnumerable<CareerEvent> NewsEvents(CareerGame g)
    {
        IEnumerable<CareerEvent> src = g.Log;
        if (_newsFilter == "") src = src.Where(e => e.Div == g.Division || e.PlayerBout);
        else if (_newsFilter != "all") src = src.Where(e => e.Div?.ToString() == _newsFilter);
        return src.Reverse().Take(40);
    }
    private string _country = "USA";
    private string _name = NameGen.Generate("USA", Random.Shared);
    private int _year = 1965;
    private string _talent = "contender";
    private WeightClass _division = WeightClass.Heavyweight;
    private IReadOnlyList<WeightClass> _divisions = new[] { WeightClass.Heavyweight };
    private bool _busy;
    private bool _hasSave;
    private readonly Random _rng = new();

    private readonly string[] _countries = { "USA", "England", "Mexico", "Germany", "Russia", "Ukraine", "Canada", "Italy", "Argentina", "Cuba", "Nigeria", "Poland" };
    private readonly int[] _years = Enumerable.Range(1945, 71).ToArray();   // 1945–2015, by year

    protected override async Task OnInitializedAsync()
    {
        RollName();
        _divisions = await Svc.AvailableDivisionsAsync();
        if (!_divisions.Contains(_division)) _division = _divisions.FirstOrDefault(WeightClass.Heavyweight);
        if (!Svc.HasCareer) _hasSave = await Svc.HasSaveAsync();
    }

    private void RollName() => _name = NameGen.Generate(_country, _rng);

    private void OnCountryChanged(ChangeEventArgs e)
    {
        _country = e.Value?.ToString() ?? "USA";
        RollName();
    }

    private static (int Lo, int Hi) TalentRange(string t) => t switch
    {
        "elite" => (85, 100),
        "journeyman" => (50, 69),
        "club" => (38, 49),
        "random915" => (80, 100),   // pot luck: a prime class anywhere from 9 (solid contender) to a rare 15
        _ => (70, 84)
    };

    private async Task StartAsync()
    {
        _busy = true;
        var (lo, hi) = TalentRange(_talent);
        int potential = _rng.Next(lo, hi + 1);
        var name = string.IsNullOrWhiteSpace(_name) ? NameGen.Generate(_country, _rng) : _name.Trim();
        // Don't start in a division that didn't exist yet.
        var div = _division.FoundedYear() <= _year ? _division
                : _divisions.Where(d => d.FoundedYear() <= _year).OrderByDescending(d => (int)d).DefaultIfEmpty(WeightClass.Heavyweight).First();
        await Svc.StartAsync(name, _country, _year, potential, div);
        _busy = false;
    }

    private async Task Continue() => await Svc.LoadAsync();
    private async Task Take()
    {
        await Svc.TakeAsync();
        _playback = Svc.LastResult;   // play the bout live before revealing the aftermath
    }
    private async Task Decline() => await Svc.DeclineAsync();
    private async Task RelinquishWbc() => await Svc.RelinquishWbcAsync();
    private async Task MoveUp() => await Svc.MoveUpAsync();
    private static string WeightText(WeightClass wc) => wc == WeightClass.Heavyweight ? "200+ lb" : $"{wc.WeightLimitLbs()} lb";
    private async Task NewCareer()
    {
        // A deliberate "clear my local history" — wipes the saved career from this browser. Confirm first so a
        // stray click can't erase a career, since there's no cloud backup to restore from.
        if (!await Js.InvokeAsync<bool>("confirm", "Clear your saved career? This erases your local history in this browser and can't be undone."))
            return;
        await Svc.AbandonAsync();
        _hasSave = false;
    }

    private static IEnumerable<string> PlayerBelts(CareerGame g) =>
        g.BeltsHeld(g.Player).Select(BeltLabel);

    /// <summary>Belt tag text — the belt name, plus its defence count when it's been defended at least once.</summary>
    private static string BeltLabel((string Belt, int Defenses) bt) =>
        bt.Defenses > 0 ? $"{bt.Belt} ·{bt.Defenses}" : bt.Belt;

    private static string ResultLong(BoutLine bt) => bt.Result switch { 'W' => "Win", 'L' => "Loss", _ => "Draw" };

    private static string NewsTag(CareerEvent e) => e.PlayerBout ? "YOU" : e.Kind switch
    {
        "title" => "TITLE", "upset" => "UPSET", "ko" => "KO", "streak" => "STREAK",
        "debut" => "DEBUT", "retire" => "RETIRED", "hof" => "HALL OF FAME", _ => "NEWS"
    };

    private static string Surname(string name)
    {
        var parts = name.Replace("\"", "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return (parts.Length > 0 ? parts[^1] : name).ToUpperInvariant();
    }

    // A world/WBA/WBC line is a "title"; a regional belt gets its own tone; everything else plain.
    private static bool IsWorldNote(string? note) => note is "World title" or "WBA title" or "WBC title" or "Undisputed title";

    private bool Won(FightResult res) => res.Winner is not null && res.Winner.Id == Svc.Game!.Player.Id;

    private string ResultWord(FightResult res) => res.IsDraw ? "DRAW" : Won(res) ? "WIN" : "LOSS";

    private static IEnumerable<(string, int)> Stats(Boxer b)
    {
        var r = b.Ratings;
        int S(int a) => Ratings.Scale15(a);
        return new[] { ("PWR", S(r.Power)), ("CHN", S(r.Chin)), ("SPD", S(r.Speed)), ("DEF", S(r.Defense)), ("STA", S(r.Stamina)),
                       ("ACC", S(r.Accuracy)), ("CON", S(r.Conditioning)), ("CUT", S(r.CutResistance)), ("AGG", S(r.Aggression)), ("HRT", S(r.Heart)) };
    }

    private static IEnumerable<(string, int)> Secondary(Boxer b)
    {
        var r = b.Ratings;
        int S(int a) => Ratings.Scale15(a);
        return new[] { ("KILL", S(SecondaryStats.KillerInstinct(r))), ("DURA", S(SecondaryStats.Durability(r))),
                       ("RECOV", S(SecondaryStats.Recovery(r))), ("PRESS", S(SecondaryStats.Pressure(r))), ("CNTR", S(SecondaryStats.Counter(b))) };
    }

    private static IEnumerable<(string, int)> Arsenal(Boxer b)
    {
        var d = PunchProfile.Distribution(b);
        return new[] { ("Jab", d.Jab), ("Cross", d.Cross), ("Hook", d.Hook), ("Uppercut", d.Uppercut), ("Body", d.Body) };
    }

    private static string ArsenalColor(string name) => name switch
    {
        "Jab" => "var(--faint)", "Cross" => "var(--accent)", "Hook" => "var(--gold)",
        "Uppercut" => "var(--win)", "Body" => "var(--violet)", _ => "var(--muted)"
    };
}
