@page "/fight"
@inject FightersService Fighters

<PageTitle>Fight Night</PageTitle>

<div class="eyebrow" style="color:var(--accent);font-weight:700;letter-spacing:.14em;text-transform:uppercase;font-size:12px;">Exhibition</div>
<h1 style="font-size:32px;margin:8px 0 4px;">Fight Night</h1>
<p class="muted">Match any two fighters — the real engine runs the bout right here in your browser.</p>

@if (_all is null)
{
    <p>Loading roster…</p>
}
else if (_result is null)
{
    <div class="row-controls">
        <select @bind="_a">
            @foreach (var f in _all) { <option value="@f.Name">@f.Name (@f.Class)</option> }
        </select>
        <span class="vs">VS</span>
        <select @bind="_b">
            @foreach (var f in _all) { <option value="@f.Name">@f.Name (@f.Class)</option> }
        </select>
        <select @bind="_rounds">
            <option value="12">12</option><option value="10">10</option><option value="8">8</option>
        </select>
        <button class="primary" @onclick="DoFight">Make the fight</button>
    </div>
}
else
{
    <FightScreen Result="_result" OnComplete="() => _result = null" />
}

@code {
    [Parameter, SupplyParameterFromQuery] public string? A { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? B { get; set; }

    private List<Boxer>? _all;
    private string _a = "", _b = "";
    private int _rounds = 12;
    private FightResult? _result;
    private string _aName = "", _bName = "";

    protected override async Task OnInitializedAsync()
    {
        _all = (await Fighters.GetAsync()).ToList();
        _a = (A is not null && _all.Any(f => f.Name == A)) ? A : (_all.FirstOrDefault(f => f.Name == "Muhammad Ali")?.Name ?? _all[0].Name);
        _b = (B is not null && _all.Any(f => f.Name == B)) ? B : (_all.FirstOrDefault(f => f.Name == "Mike Tyson")?.Name ?? _all[1].Name);
    }

    private void DoFight()
    {
        if (_all is null) return;
        var a = _all.First(f => f.Name == _a);
        var b = _all.First(f => f.Name == _b);
        _aName = a.Name; _bName = b.Name;
        var engine = new FightEngine(new Random());
        _result = engine.Simulate(a, b, _rounds);
    }
}
