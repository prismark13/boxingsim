@* Live broadcast playback of a pre-simulated bout, driven by the engine's 15-second ticks. *@

<div class="fightscreen">
    <div class="scorebug">
        <div class="corner a">
            <div class="cname">@A.Name</div>
            <div class="cmeta"><span class="cc">@Ui.Code(A.Country)</span> @A.Class</div>
            <div class="hp"><span class="hpfill" style="width:@HpA%;background:@HpColor(HpA)"></span></div>
        </div>
        <div class="center">
            <div class="rd">Round @_round / @Result.ScheduledRounds</div>
            <div class="clock">@_clock</div>
        </div>
        <div class="corner b">
            <div class="cname">@B.Name</div>
            <div class="cmeta">@B.Class <span class="cc">@Ui.Code(B.Country)</span></div>
            <div class="hp right"><span class="hpfill" style="width:@HpB%;background:@HpColor(HpB)"></span></div>
        </div>
    </div>

    <div class="feed">
        @foreach (var line in _feed)
        {
            <div class="fl @line.Cls">@line.Text</div>
        }
    </div>

    @if (_cards.Count > 0)
    {
        <div class="scorecard">
            <span class="label">Judges</span>
            @foreach (var c in _cards)
            {
                <span class="jc">@c.A–@c.B</span>
            }
        </div>
    }

    @if (_done && Result.Rounds.Count > 0)
    {
        <div class="fs-cardwrap">
            <div class="label">Scorecard by round</div>
            <div class="rounds-tbl">
                <div class="rtr rth"><span>Rd</span><span>@Sur(A.Name)</span><span>@Sur(B.Name)</span><span>Card</span></div>
                @foreach (var rd in Result.Rounds)
                {
                    <div class="rtr @(rd.ScoreA > rd.ScoreB ? "won" : rd.ScoreA < rd.ScoreB ? "lost" : "")">
                        <span>@rd.Round</span>
                        <span>@rd.LandedA</span>
                        <span>@rd.LandedB</span>
                        <span class="rcard">@rd.ScoreA–@rd.ScoreB@if (rd.KnockdownsB > 0) { <b class="kd for">@rd.KnockdownsB KD</b>} @if (rd.KnockdownsA > 0) { <b class="kd against">@rd.KnockdownsA KD</b>}</span>
                    </div>
                }
                <div class="rtr rtf">
                    <span>@(_stoppedEarly ? "≈" : "Σ")</span>
                    <span>@Result.Rounds.Sum(r => r.LandedA)</span>
                    <span>@Result.Rounds.Sum(r => r.LandedB)</span>
                    <span class="rcard">@Result.Rounds.Sum(r => r.ScoreA)–@Result.Rounds.Sum(r => r.ScoreB)</span>
                </div>
            </div>
        </div>
    }

    <div class="fs-controls">
        @if (_done)
        {
            <div class="fs-result">@Result.Headline()</div>
            <button class="primary" @onclick="OnComplete">Continue</button>
        }
        else
        {
            <button class="ghost @(_speed==1400?"on":"")" @onclick="() => _speed = 1400">0.5×</button>
            <button class="ghost @(_speed==800?"on":"")" @onclick="() => _speed = 800">1×</button>
            <button class="ghost @(_speed==400?"on":"")" @onclick="() => _speed = 400">2×</button>
            <button class="ghost" @onclick="Skip">Skip to result</button>
        }
    </div>
</div>

@code {
    [Parameter] public FightResult Result { get; set; } = default!;
    [Parameter] public EventCallback OnComplete { get; set; }

    private Boxer A => Result.A;
    private Boxer B => Result.B;

    private int _round;
    private string _clock = "3:00";
    private double _dmgA, _dmgB, _bodyA, _bodyB;
    private int _kdA, _kdB, _lastLandedA, _lastLandedB;
    private int _speed = 800;   // ms per 15-second tick — a calmer, more readable default pace
    private bool _skip, _done, _started;
    private readonly List<(string Text, string Cls)> _feed = new();
    private readonly List<(int A, int B)> _cards = new();
    private readonly Random _r = new();
    private double _cutA, _cutB, _swellA, _swellB;
    private string? _cutLocA, _cutLocB, _swellLocA, _swellLocB;
    private bool _swellEyeA, _swellEyeB;

    private static string CutType(double c) => c >= 0.85 ? "a horrible gash" : c >= 0.6 ? "a deep cut" : c >= 0.35 ? "a cut" : "a nick";

    private int HpA => (int)Math.Round(Math.Max(0, 1 - Math.Max(_dmgA, _bodyA * 0.85)) * 100);
    private int HpB => (int)Math.Round(Math.Max(0, 1 - Math.Max(_dmgB, _bodyB * 0.85)) * 100);

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first && !_started) { _started = true; await Play(); }
    }

    private async Task Play()
    {
        Push("The fighters meet in the center — here we go.", "quiet");
        await Tick();

        foreach (var rd in Result.Rounds)
        {
            _round = rd.Round;
            _kdA = _kdB = _lastLandedA = _lastLandedB = 0;
            _cutLocA = rd.CutLocA; _cutLocB = rd.CutLocB;
            _swellLocA = rd.SwellLocA; _swellLocB = rd.SwellLocB;
            _swellEyeA = rd.SwellEyeA; _swellEyeB = rd.SwellEyeB;
            if (!_skip) { Push($"— Round {rd.Round} —", "round"); await Tick(); }

            bool stopped = false;
            foreach (var t in rd.Ticks)
            {
                _clock = t.Clock;
                _dmgA = t.DamageA; _dmgB = t.DamageB; _bodyA = t.BodyA; _bodyB = t.BodyB;
                Narrate(t);
                if (t.Fin is not null) stopped = true;
                if (!_skip) await Tick();
            }

            if (rd.Judges is not null)
            {
                for (int j = 0; j < 3; j++)
                {
                    if (_cards.Count <= j) _cards.Add((0, 0));
                    _cards[j] = (_cards[j].A + rd.Judges[j].A, _cards[j].B + rd.Judges[j].B);
                }
            }
            if (stopped) break;
            if (!_skip) { await InvokeAsync(StateHasChanged); }
        }

        _done = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Tick()
    {
        await InvokeAsync(StateHasChanged);
        if (!_skip) await Task.Delay(_speed);
    }

    private void Skip() => _skip = true;

    private void Narrate(FightTick t)
    {
        double dCutA = t.CutA - _cutA, dCutB = t.CutB - _cutB;
        double dSwellA = t.SwellA - _swellA, dSwellB = t.SwellB - _swellB;
        int dA = t.LandedA - _lastLandedA, dB = t.LandedB - _lastLandedB;
        _cutA = t.CutA; _cutB = t.CutB; _swellA = t.SwellA; _swellB = t.SwellB; _lastLandedA = t.LandedA; _lastLandedB = t.LandedB;

        if (t.Fin is StopInfo fin) { Push(StopLine(fin), "big"); return; }

        if (t.KnockdownsA > _kdA) { _kdA = t.KnockdownsA; Push(KnockdownLine(A.Name, t.DownBodyA), "down"); return; }
        if (t.KnockdownsB > _kdB) { _kdB = t.KnockdownsB; Push(KnockdownLine(B.Name, t.DownBodyB), "down"); return; }

        if (t.StaggerB) { Push(StaggerLine(A.Name, B.Name), "hurt"); return; }
        if (t.StaggerA) { Push(StaggerLine(B.Name, A.Name), "hurt"); return; }

        if (t.CounterA) { Push(Pick($"{A.Name} catches him coming in — a beautiful counter!", $"{A.Name} times it perfectly, turning {B.Name}'s attack against him!"), "land"); return; }
        if (t.CounterB) { Push(Pick($"{B.Name} catches him coming in — a beautiful counter!", $"{B.Name} times it perfectly, turning {A.Name}'s attack against him!"), "land"); return; }

        if (dCutB >= 0.12) { Push($"Blood! {CutType(t.CutB)} opens {_cutLocB ?? "over the eye"} on {B.Name}.", "foul"); return; }
        if (dCutA >= 0.12) { Push($"Blood! {CutType(t.CutA)} opens {_cutLocA ?? "over the eye"} on {A.Name}.", "foul"); return; }
        // An existing cut works open further, or the corner gets it back under control.
        if (dCutB >= 0.05 && t.CutB >= 0.4) { Push($"That cut {_cutLocB ?? ""} on {B.Name} is worsening — blood streaming down, the doctor takes a look.", "foul"); return; }
        if (dCutA >= 0.05 && t.CutA >= 0.4) { Push($"That cut {_cutLocA ?? ""} on {A.Name} is worsening — blood streaming down, the doctor takes a look.", "foul"); return; }
        if (dCutB <= -0.06 && t.CutB >= 0.15) { Push($"The cutman has done his work — {B.Name}'s {_cutLocB ?? "cut"} looks better this round.", "land"); return; }
        if (dCutA <= -0.06 && t.CutA >= 0.15) { Push($"The cutman has done his work — {A.Name}'s {_cutLocA ?? "cut"} looks better this round.", "land"); return; }
        // Swelling coming up, and an eye closing.
        if (dSwellB >= 0.13 && _swellLocB is not null) { Push(_swellEyeB && t.SwellB >= 0.5 ? $"{B.Name}'s eye is closing fast — he's fighting half-blind now." : $"Swelling coming up on {B.Name} — {_swellLocB}.", "foul"); return; }
        if (dSwellA >= 0.13 && _swellLocA is not null) { Push(_swellEyeA && t.SwellA >= 0.5 ? $"{A.Name}'s eye is closing fast — he's fighting half-blind now." : $"Swelling coming up on {A.Name} — {_swellLocA}.", "foul"); return; }

        if (t.BigA && t.PunchA is not null) { Push(BigLine(A.Name, B.Name, t.PunchA, t.BodyShotA, t.RockB), t.RockB >= 2 ? "hurt" : "land"); return; }
        if (t.BigB && t.PunchB is not null) { Push(BigLine(B.Name, A.Name, t.PunchB, t.BodyShotB, t.RockA), t.RockA >= 2 ? "hurt" : "land"); return; }

        if (t.HandA) { Push($"{A.Name} shakes his hand — he may have damaged it on that shot.", "quiet"); return; }
        if (t.HandB) { Push($"{B.Name} shakes his hand — he may have damaged it on that shot.", "quiet"); return; }

        if (t.Foul is FoulEvent f) { Push($"{(f.Who == 0 ? A.Name : B.Name)} — {f.Type}{(f.Deduct ? ". A point comes off!" : ". The ref warns him.")}", "foul"); return; }

        Push(Filler(dA, dB), "quiet");
    }

    private string StopLine(StopInfo fin)
    {
        string w = fin.Winner == 0 ? A.Name : B.Name, l = fin.Winner == 0 ? B.Name : A.Name;
        return fin.Method switch
        {
            "KO" => Pick($"AND HE'S OUT! {w} lands flush — {l} is counted out. What a knockout!",
                         $"TIMBER! {l} goes down and stays down — {w} by spectacular KO!",
                         $"{w} turns out the lights — {l} is flat on his back!"),
            "TKO" => fin.Body
                ? Pick($"A sickening body shot folds {l} up — the ref waves it off! {w} wins.",
                       $"{l} sinks to a knee clutching his ribs — it's over, {w} by TKO.")
                : Pick($"The referee has seen enough — {l} is defenceless! {w} by TKO.",
                       $"{w} is teeing off and the ref jumps in to rescue {l}!"),
            "DQ" => $"Disqualification! {l} is thrown out — {w} wins on a foul.",
            _ => $"It's all over — {w} gets the win."
        };
    }

    private string KnockdownLine(string name, bool body) => body
        ? Pick($"DOWN! {name} is dropped by a shot to the body — he's in agony!", $"DOWN! A thudding body shot puts {name} on the canvas!")
        : Pick($"DOWN GOES {name.ToUpperInvariant()}! He's been floored!", $"DOWN! {name} crashes to the canvas!", $"{name} is DOWN — he never saw it coming!");

    private string StaggerLine(string att, string def) =>
        Pick($"{att} has {def} badly hurt — he's letting his hands go!",
             $"{def} is on rubber legs and {att} is teeing off!",
             $"{att} smells blood — unloading on a hurt man!");

    private string BigLine(string att, string def, string punch, bool body, int rock)
    {
        string shot = body ? Pick($"rips {punch}", $"digs in {punch}", $"buries {punch}")
                           : Pick($"lands {punch}", $"connects with {punch}", $"snaps off {punch}");
        string tail = rock >= 2 ? Pick($" — {def} is hurt!", $" — {def} is in real trouble!")
                    : rock >= 1 ? Pick($" — {def} felt that.", $" — that got his respect.") : "";
        return $"{att} {shot}{tail}";
    }

    private string Filler(int dA, int dB)
    {
        bool late = Result.ScheduledRounds >= 8 && _round >= Result.ScheduledRounds - 2;
        if (dA + dB == 0) return Pick("A tense, tactical spell.", "They feel each other out.", "Both reset, hunting the opening.");
        if (dA > dB + 1) return Pick($"{A.Name} controls the range behind the jab.", $"{A.Name} is busier, dictating the pace.", late ? $"{A.Name} digs deep down the stretch." : $"{A.Name} backs him up with sharp work.");
        if (dB > dA + 1) return Pick($"{B.Name} walks him down, landing the cleaner shots.", $"{B.Name} steps it up to the body.", late ? $"{B.Name} finds another gear late." : $"{B.Name} presses forward behind the jab.");
        return Pick("They trade in the pocket — toe to toe!", "A fierce exchange up close!", "Both men let their hands go!");
    }

    private string Pick(params string[] o) => o[_r.Next(o.Length)];

    private bool _stoppedEarly => Result.Outcome is FightOutcome.Knockout or FightOutcome.TechnicalKnockout;

    private static string Sur(string name)
    {
        var parts = name.Replace("\"", "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? parts[^1] : name;
    }

    private static string HpColor(int hp) => hp > 60 ? "var(--win)" : hp > 30 ? "var(--gold)" : "var(--loss)";

    private void Push(string text, string cls)
    {
        _feed.Insert(0, (text, cls));
        if (_feed.Count > 16) _feed.RemoveAt(_feed.Count - 1);
    }
}
