<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:BoxingSim.Desktop">

    <!-- SURFACES.
         These used to be four shades of the same cold blue-grey, a few points of lightness apart, so every
         panel sat at the same depth and the whole app read as an admin dashboard that happened to be about
         boxing. They are now warm and properly spaced: a dark room with the ring lit in it. The hue is low
         saturation on the warm side, which is the colour of everything a fight actually happens under —
         canvas, ropes, house lights — without tipping into brown. -->
    <Color x:Key="BgColor">#0A0908</Color>
    <Color x:Key="PanelColor">#14120F</Color>
    <Color x:Key="Panel2Color">#1E1A15</Color>
    <Color x:Key="LineColor">#2B261F</Color>
    <Color x:Key="Line2Color">#3D362C</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Panel2" Color="{StaticResource Panel2Color}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Line2" Color="{StaticResource Line2Color}" />

    <SolidColorBrush x:Key="Text" Color="#F3EFE9" />
    <SolidColorBrush x:Key="Muted" Color="#9C9285" />
    <SolidColorBrush x:Key="Faint" Color="#6C6357" />

    <!-- ROLES. One colour, one meaning. The blue used to do six different jobs — selected nav, headings,
         links, buttons, the player's bars, the shape-of-the-round lines — and a colour that means everything
         signals nothing. It now means exactly one thing: YOU. Against warm surfaces it also finally reads as
         a colour rather than as the app's general tint. -->
    <SolidColorBrush x:Key="Accent" Color="#4FA3FF" />      <!-- your corner, and your actions -->
    <SolidColorBrush x:Key="AccentSoft" Color="#12233A" />
    <SolidColorBrush x:Key="Gold" Color="#FFC24D" />        <!-- titles, belts, honours -->
    <SolidColorBrush x:Key="GoldSoft" Color="#2C2413" />
    <SolidColorBrush x:Key="GoldLine" Color="#6E571F" />
    <SolidColorBrush x:Key="Win" Color="#4FD98B" />
    <SolidColorBrush x:Key="Loss" Color="#FF6B6B" />

    <!-- The other man. Boxing already solved this: the player fights out of the blue corner, so his opponent
         gets the red one. Anything grey reads as an absence rather than a fighter — an opponent's best
         attribute drawn in the same colour as an empty track looks like nothing is there at all. Deliberately
         warmer and more orange than Loss, which means a defeat and would put a verdict on a man who has not
         fought yet. -->
    <SolidColorBrush x:Key="Foe" Color="#FF7A47" />

    <!-- THE MARK. A ring bell, drawn rather than drawn ON: vector geometry so it stays sharp from a 16px
         taskbar icon up to the setup screen, with no image file to ship and nothing to license. The shape is
         the timekeeper's bell - a mounted dome, a broad rim, and the striker beneath it. -->
    <GeometryGroup x:Key="BellGeometry" FillRule="Nonzero">
        <!-- the mounting post and bracket it hangs from -->
        <RectangleGeometry Rect="11.1,1.4,1.8,2.4" RadiusX="0.6" RadiusY="0.6" />
        <RectangleGeometry Rect="8.4,3.2,7.2,1.5" RadiusX="0.7" RadiusY="0.7" />
        <!-- the dome -->
        <PathGeometry Figures="M12,4.6 C7.4,4.6 4.7,8.3 4.7,13 L4.7,15.6 L19.3,15.6 L19.3,13 C19.3,8.3 16.6,4.6 12,4.6 Z" />
        <!-- the rim, wider than the body the way a bell flares -->
        <RectangleGeometry Rect="3.1,15.9,17.8,2.1" RadiusX="1" RadiusY="1" />
        <!-- the striker -->
        <EllipseGeometry Center="12,20.6" RadiusX="1.7" RadiusY="1.7" />
    </GeometryGroup>

    <!-- The window and taskbar icon. Gold on nothing, so it reads on a light or dark shell. -->
    <DrawingImage x:Key="AppIcon">
        <DrawingImage.Drawing>
            <GeometryDrawing Geometry="{StaticResource BellGeometry}">
                <GeometryDrawing.Brush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFD277" Offset="0" />
                        <GradientStop Color="#E09A28" Offset="1" />
                    </LinearGradientBrush>
                </GeometryDrawing.Brush>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Neutral emphasis: what nav, links and headings use now that the blue is spoken for. Hierarchy comes
         from weight and brightness instead of from spending the one colour that means something. -->
    <SolidColorBrush x:Key="Quiet" Color="#B8AE9F" />

    <!-- Type -->
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />

    </Style>

    <Style x:Key="PanelHeader" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="Margin" Value="16,14,16,10" />
    </Style>

    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />

    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Panel2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#2A241D" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="#CFE4FF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Tab strip -->
    <Style x:Key="TabButton" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="9" Padding="14,9" Margin="0,0,6,0">
                        <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontSize="12"
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="t" Property="Foreground" Value="#04121F" />
                            <Setter TargetName="t" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Panel2}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- WPF's stock ComboBox keeps its own light chrome whatever Background you set, which left the selected
         text unreadable on the dark card. This templates the whole control: the closed box, the arrow, and the
         drop-down popup. -->
    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Panel2}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{StaticResource Panel2}"
                                            BorderBrush="{StaticResource Line2}" BorderThickness="1"
                                            CornerRadius="8">
                                        <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,12,0" Data="M 0 0 L 4 4 L 8 0"
                                              Stroke="{StaticResource Muted}" StrokeThickness="1.4" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="Left" IsHitTestVisible="False"
                                          TextElement.Foreground="{StaticResource Text}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               PopupAnimation="Fade" Focusable="False">
                            <Border Background="#0E131B" BorderBrush="{StaticResource Line2}" BorderThickness="1"
                                    CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0">
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Setting width and background is not enough: the stock template still draws its own light chrome and
         two arrow buttons, which on a dark panel reads as a bright bar down the edge of the content. The whole
         template has to go. What is left is a thumb that sits quietly until the pointer is near it. -->
    <Style TargetType="Thumb" x:Key="ScrollThumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" Background="#332C24" CornerRadius="3" Margin="2,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#463D31" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#5C5142" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <!-- No arrow buttons, but the track still has to page when clicked. -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Line}"
                            BorderThickness="0,0,0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar navigation. A ListBox gives selection state for free; this just makes it look like nav. -->
    <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- Without this the item's accessible name is the record's ToString(), which is unusable to a screen
             reader (and to UI automation). -->
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,1">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9" Padding="14,10" />
                        <Border x:Name="bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Background="Transparent" Margin="1,0,0,0" />
                        <TextBlock x:Name="t" Text="{Binding Label}" FontSize="13" Margin="14,10"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}" />
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <!-- Where you are is not who you are. This used to be painted in the player's blue,
                             which spent the one colour that means "you" on a piece of furniture. Neutral
                             surface, gold marker, weight for emphasis. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}" />
                            <Setter TargetName="bar" Property="Background" Value="{StaticResource Gold}" />
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="t" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <!-- A section header labels the group beneath it; it isn't a destination. -->
                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource Faint}" />
                            <Setter TargetName="t" Property="FontSize" Value="9.5" />
                            <Setter TargetName="t" Property="FontWeight" Value="Bold" />
                            <Setter TargetName="t" Property="Margin" Value="14,18,14,4" />
                            <Setter TargetName="b" Property="Background" Value="Transparent" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The dimmed area behind an overlay, clickable to dismiss it — an overlay with only a small Close button
         and a dead backdrop feels like a trap. -->
    <Style x:Key="BackdropButton" TargetType="Button">
        <Setter Property="Background" Value="#D8060A10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The X in an overlay's corner. -->
    <Style x:Key="CloseXButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="8">
                        <TextBlock x:Name="t" Text="✕" FontSize="13" Foreground="{StaticResource Faint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}" />
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small segmented control: the speed the fight is called at. -->
    <Style x:Key="SpeedButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="7" Padding="13,7" Margin="0,0,6,0">
                        <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontSize="12"
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="t" Property="Foreground" Value="#CFE4FF" />
                            <Setter TargetName="t" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A whole list row that behaves as a button, so clicking anywhere on a fighter opens his card. -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Line}"
                            BorderThickness="0,0,0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Every content page: heading, context line, scrolling body in a card. -->
    <Style TargetType="{x:Type local:PageHost}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PageHost}">
                    <Grid Margin="28,26,28,28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="2,0,0,16">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="19" FontWeight="Light"
                                       Foreground="{StaticResource Text}" />
                            <TextBlock Text="{TemplateBinding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,4,0,8">
                                <ContentPresenter />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
