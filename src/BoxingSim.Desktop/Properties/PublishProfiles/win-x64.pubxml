<?xml version="1.0" encoding="utf-8"?>
<!--
  A self-contained build that needs no .NET install on the target machine.

      dotnet publish src/BoxingSim.Desktop -p:PublishProfile=win-x64

  Output is a FOLDER, not one file. Copy the whole folder and run BoxingSim.exe inside it.

  Single-file was tried and rejected: WPF has native components, so PublishSingleFile has to self-extract the
  whole bundle on first run. Measured on this machine that was 32 seconds with no window on screen (the same
  with compression on or off — it is the extraction and the virus scan of the unpacked files, not the size).
  A game that shows nothing for half a minute after a double-click reads as hung. This folder build starts in
  about two seconds cold. Add <PublishSingleFile>true</PublishSingleFile> below if one file matters more than
  first-run speed.

  Trimming is off: WPF and the save layer both use reflection, and a trimmed build fails at runtime rather
  than at publish time.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
