<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The file on disk stays BoxingSim.exe: the name is referenced by the MSIX manifest, the packaging
         script and every GitHub release asset, and nobody sees a filename that an app title doesn't cover.
         What the user actually reads — title bar, Task Manager, the exe's Details tab — comes from these. -->
    <AssemblyName>BoxingSim</AssemblyName>
    <Product>The Final Bell</Product>
    <AssemblyTitle>The Final Bell</AssemblyTitle>
    <Company>Prismark</Company>
    <Version>0.7.4</Version>
    <!-- Shipping: one file, no debug symbols beside it, and everything it needs inside. -->
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Only legal for a self-contained bundle; it fails the framework-dependent publish outright. -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)'=='true'">true</EnableCompressionInSingleFile>
    <RootNamespace>BoxingSim.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoxingSim.Core\BoxingSim.Core.csproj" />
  </ItemGroup>

  <!-- Real audio. Copied beside the exe for a normal run so the files can be swapped without a rebuild, and
       ALSO embedded so a single-file publish carries them: without the embedded copy a shipped build would
       quietly fall back to synthesised sound the moment the folder was not next to it. -->
  <ItemGroup>
    <None Include="assets/audio/**/*.*" CopyToOutputDirectory="PreserveNewest"
          Link="assets/audio/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets/audio/*.wav" LogicalName="audio.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The roster is BOTH embedded and copied beside the .exe. Embedding keeps a single-file publish genuinely
       standalone; the loose copy lets the data be swapped without a rebuild, and wins when present. -->
  <ItemGroup>
    <EmbeddedResource Include="..\BoxingSim.App\wwwroot\data\fighters.json" LogicalName="fighters.json" />
    <None Include="..\BoxingSim.App\wwwroot\data\fighters.json" Link="data\fighters.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
