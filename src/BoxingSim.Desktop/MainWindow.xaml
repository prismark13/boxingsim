<Window x:Class="BoxingSim.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BoxingSim.Desktop"
        xmlns:pages="clr-namespace:BoxingSim.Desktop.Pages"
        Title="The Final Bell" Height="920" Width="1500" MinHeight="660" MinWidth="1120"
        Icon="{StaticResource AppIcon}"
        Background="{StaticResource Bg}" TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI" UseLayoutRounding="True">

    <!-- The app says when it is thinking: the pointer becomes a wait cursor and a banner names the work. -->
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Busy}" Value="True">
                    <Setter Property="Cursor" Value="Wait" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>


    <!-- Keyboard is the fastest way around a shell like this. Ctrl+1..8 jump straight to a page, Alt+Left goes
         back, Escape backs out of an overlay, Enter takes the fight you're being offered. -->
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Dashboard" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Career" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Stats" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Rankings" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="P4P" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Champions" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="News" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Hall" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Awards" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="About" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding GoBack}" />
        <KeyBinding Key="Back" Modifiers="Alt" Command="{Binding GoBack}" />
        <KeyBinding Key="Escape" Command="{Binding Dismiss}" />
        <KeyBinding Key="Enter" Command="{Binding TakeFight}" />
    </Window.InputBindings>


    <Grid>
        <!-- ============================ SETUP ============================ -->
        <pages:SetupView Visibility="{Binding AtSetup, Converter={StaticResource BoolVis}}" />

        <!-- ============================ APP SHELL ============================ -->
        <Grid Visibility="{Binding InPlay, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ SIDEBAR ============ -->
            <Border Background="#110F0C" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Who you are. Clickable: every other fighter in the world has a card showing his
                         attributes, his form and his whole record, and the one man you could not look up that
                         way was your own. -->
                    <Button Style="{StaticResource RowButton}" Command="{Binding ShowMyCard}"
                            AutomationProperties.Name="My fighter card" ToolTip="See your fighter card"
                            Visibility="{Binding InCareer, Converter={StaticResource BoolVis}}">
                    <StackPanel Margin="22,26,22,20">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="10" Width="52" Height="42">
                                <TextBlock Text="{Binding PlayerClass}" FontSize="21" FontWeight="Light"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding PlayerClass, Converter={StaticResource ClassColour}}" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlayerRecord}" FontSize="15" Foreground="{StaticResource Text}" />
                                <TextBlock Text="{Binding PlayerStanding}" FontSize="11" FontWeight="SemiBold"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlayerIsChampion}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding PlayerHeadline}" FontSize="21" FontWeight="Light"
                                   Foreground="{StaticResource Text}" Margin="0,14,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PlayerIdentity}" FontSize="12" Foreground="{StaticResource Faint}"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="see your attributes ›" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{StaticResource Quiet}" />
                    </StackPanel>
                    </Button>

                    <!-- A universe has no fighter to head the sidebar, so it says what it is instead.

                         The clock is read through UniversePage rather than moved into the shell: this is the
                         same state the THIS WEEK page shows, and one clock with two readers beats two that can
                         disagree. The path form rather than a DataContext override, because the Visibility on
                         this panel is the shell's own InUniverse and has to stay in the shell's context. -->
                    <StackPanel Margin="22,26,22,20" Visibility="{Binding InUniverse, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="UNIVERSE" Style="{StaticResource Label}" Foreground="{StaticResource Gold}" />
                        <TextBlock Text="{Binding UniversePage.UniverseDate}" FontSize="21" FontWeight="Light"
                                   Foreground="{StaticResource Text}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding UniversePage.UniverseWeekLabel}" FontSize="12"
                                   Foreground="{StaticResource Faint}" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- Where you're going.
                         A Grid rather than a StackPanel, because a StackPanel hands its children unlimited
                         height: at the smallest window the app allows (1120x660) the list simply ran off the
                         bottom and Hall of Fame, Awards, Settings and About could not be reached at all — no
                         scrollbar, no clipping indicator, the items were just gone. The row is starved to the
                         space that is actually left and the list scrolls inside it. -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- The glyph is decoration; the accessible name is the plain word. -->
                        <Button Content="← Back" AutomationProperties.Name="Back" Command="{Binding GoBack}"
                                Margin="24,0,24,10" Padding="10,6" FontSize="12" HorizontalAlignment="Left"
                                ToolTip="Alt+Left" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}"
                                     ItemContainerStyle="{StaticResource NavItemStyle}" Margin="12,0" />
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="22,0,22,20">
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14" />
                        <TextBlock Text="{Binding DateLabel}" FontSize="13" Foreground="{StaticResource Text}"
                                   Visibility="{Binding InCareer, Converter={StaticResource BoolVis}}" />
                        <Button Content="Abandon career" Command="{Binding AbandonCareer}" Margin="0,12,0,0"
                                Padding="10,7" FontSize="11" HorizontalAlignment="Stretch"
                                Visibility="{Binding InCareer, Converter={StaticResource BoolVis}}" />
                        <Button Content="Close universe" Command="{Binding LeaveUniverse}"
                                Padding="10,7" FontSize="11" HorizontalAlignment="Stretch"
                                Visibility="{Binding InUniverse, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ CONTENT ============ -->
            <Grid Grid.Column="1">

                <pages:DashboardView DataContext="{Binding DashboardPage}"
                                     Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window},
                                                  Converter={StaticResource PageVis}, ConverterParameter=Dashboard}" />

                <pages:CampView Visibility="{Binding CurrentPage, Converter={StaticResource PageVis},
                                                      ConverterParameter=Career}" />

                <!-- ============ LIST PAGES ============ -->
                <pages:RankingsView DataContext="{Binding RankingsPage}"
                                    Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource PageVis}, ConverterParameter=Rankings}" />

                <pages:PoundForPoundView DataContext="{Binding PoundForPoundPage}"
                                         Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window},
                                                      Converter={StaticResource PageVis}, ConverterParameter=P4P}" />

                <pages:HallOfFameView DataContext="{Binding HallOfFamePage}"
                                      Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource PageVis}, ConverterParameter=Hall}" />

                <pages:ChampionsView DataContext="{Binding ChampionsPage}"
                                     Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window},
                                                  Converter={StaticResource PageVis}, ConverterParameter=Champions}" />

                <pages:AwardsView DataContext="{Binding AwardsPage}"
                                  Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource PageVis}, ConverterParameter=Awards}" />

                <pages:NewsView DataContext="{Binding NewsPage}"
                                Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window},
                                             Converter={StaticResource PageVis}, ConverterParameter=News}" />

                <pages:StatsView DataContext="{Binding StatsPage}"
                                 Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window},
                                              Converter={StaticResource PageVis}, ConverterParameter=Stats}" />

                <pages:UniverseView DataContext="{Binding UniversePage}"
                                    Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource PageVis}, ConverterParameter=Universe}" />

                <pages:SettingsView Visibility="{Binding CurrentPage, Converter={StaticResource PageVis},
                                                          ConverterParameter=Settings}" />

                <pages:AboutView Visibility="{Binding CurrentPage, Converter={StaticResource PageVis},
                                                       ConverterParameter=About}" />
            </Grid>

            <!-- ============ FIGHT NIGHT ============ -->
            <!-- The fight takes the whole window and is CALLED, line by line, rather than tabulated. -->
            <Grid Grid.ColumnSpan="2" Panel.ZIndex="9"
                  Visibility="{Binding IsPlayingBack, Converter={StaticResource BoolVis}}">
                <!-- Opaque, not 95%. A translucent overlay let the whole dashboard - the sidebar, the date,
                     the news list - ghost through behind the commentary, and reading a fight through a layer
                     of unrelated text was the single worst thing about the screen. -->
                <Border Background="#080706" />
                <Grid Margin="0,26,0,26" MaxWidth="980">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="{Binding FightNightBillLine}" Style="{StaticResource Label}"
                                   HorizontalAlignment="Center" Foreground="{StaticResource Gold}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Right" Margin="0,0,26,0">
                                <TextBlock Text="{Binding FightNightHome}" FontSize="26" FontWeight="Light"
                                           Foreground="{StaticResource Text}" TextAlignment="Right" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding FightNightHomeRecord}" FontSize="13"
                                           Foreground="{StaticResource Muted}" TextAlignment="Right" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="vs" FontSize="15" Foreground="{StaticResource Faint}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Left" Margin="26,0,0,0">
                                <TextBlock Text="{Binding FightNightAway}" FontSize="26" FontWeight="Light"
                                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding FightNightAwayRecord}" FontSize="13"
                                           Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- The scoreboard MOVES with the call: round, clock, and each man's share of the
                             punches landed leaning against each other. Without something changing, a wall of
                             text has nothing to land against. -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding LiveMine}" FontSize="30" FontWeight="Light"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,18,0" />
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding LiveRound}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource Text}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding LiveClock}" FontSize="21" FontFamily="Consolas"
                                           Foreground="{StaticResource Gold}" HorizontalAlignment="Center"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="PUNCHES LANDED" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <!-- His count in his corner's colour, matching the bar beneath it. In muted grey next
                                 to the player's blue it read as a caption rather than the other man's score. -->
                            <TextBlock Grid.Column="2" Text="{Binding LiveHis}" FontSize="30" FontWeight="Light"
                                       Foreground="{StaticResource Foe}" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="18,0,0,0" />
                        </Grid>

                        <!-- What each man has left. This is the engine's own fatigue - the thing that actually
                             fades a fighter - so the bar falling IS the reason his output is dropping, not a
                             decoration alongside it. Each man keeps his corner's colour as it drains, and goes
                             red when the tank is genuinely low. -->
                        <Grid Margin="0,10,0,0" Height="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="MineGas">
                                <Border Background="{StaticResource Line}" CornerRadius="4" />
                                <Border HorizontalAlignment="Right" CornerRadius="4"
                                        Background="{Binding LiveMyGas, Converter={StaticResource GasBrush}, ConverterParameter=mine}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource BarWidth}">
                                            <Binding Path="LiveMyGas" />
                                            <Binding Path="ActualWidth" ElementName="MineGas" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Grid>
                            <Grid x:Name="HisGas" Grid.Column="2">
                                <Border Background="{StaticResource Line}" CornerRadius="4" />
                                <Border HorizontalAlignment="Left" CornerRadius="4"
                                        Background="{Binding LiveHisGas, Converter={StaticResource GasBrush}, ConverterParameter=his}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource BarWidth}">
                                            <Binding Path="LiveHisGas" />
                                            <Binding Path="ActualWidth" ElementName="HisGas" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Grid>
                        </Grid>
                        <TextBlock Text="STAMINA" FontSize="11" FontWeight="Bold" Margin="0,3,0,0"
                                   HorizontalAlignment="Center" Foreground="{StaticResource Faint}" />

                        <!-- A man in trouble is stated plainly, and stays stated while he is. -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HURT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Loss}"
                                       HorizontalAlignment="Right" Margin="0,0,18,0"
                                       Visibility="{Binding MyManHurt, Converter={StaticResource BoolVis}}" />
                            <TextBlock Grid.Column="1" Text="HURT" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource Loss}" HorizontalAlignment="Left" Margin="18,0,0,0"
                                       Visibility="{Binding HisManHurt, Converter={StaticResource BoolVis}}" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Background="#100E0B">
                        <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto" Padding="30,22,30,22"
                                      ScrollChanged="FeedScroll_ScrollChanged">
                            <!-- Bottom-aligned: with finished rounds folded away the call is short, and
                                 growing upward from a fixed point reads far better than floating in a void. -->
                            <ItemsControl ItemsSource="{Binding Rounds}" VerticalAlignment="Bottom">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <!-- The round heading doubles as the fold: click it to reopen a
                                                 round that has already been fought. -->
                                            <Button Style="{StaticResource RowButton}" HorizontalAlignment="Stretch"
                                                    AutomationProperties.Name="{Binding Title}"
                                                    Command="{Binding DataContext.ToggleRound, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Grid Margin="0,10,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                               Foreground="{StaticResource Accent}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="13"
                                                               FontStyle="Italic" Foreground="{StaticResource Faint}"
                                                               Margin="14,2,0,0" TextWrapping="Wrap"
                                                               Visibility="{Binding HasSummary, Converter={StaticResource BoolVis}}" />
                                                </Grid>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,0,0,4"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Whose work this line is, without spending a word on it.
                                                         A thin mark in the man's corner colour lets you follow
                                                         one fighter down the feed at a glance. -->
                                                    <Border Grid.Column="0" CornerRadius="1.5" Margin="0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource Accent}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsHis}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource Foe}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Clock}" FontSize="11"
                                                               FontFamily="Consolas"
                                                               Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Text}" TextWrapping="Wrap"
                                                               FontSize="15" Foreground="{StaticResource Quiet}"
                                                               RenderTransformOrigin="0,0.5">
                                                        <TextBlock.RenderTransform>
                                                            <TranslateTransform x:Name="tt" X="0" />
                                                        </TextBlock.RenderTransform>
                                                        <TextBlock.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="0" To="1" Duration="0:0:0.22" />
                                                                        <DoubleAnimation Storyboard.TargetName="tt"
                                                                                         Storyboard.TargetProperty="X"
                                                                                         From="16" To="0" Duration="0:0:0.22">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </TextBlock.Triggers>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBig}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDrama}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                        <Setter Property="FontSize" Value="18" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsVerdict}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Win}" />
                                                                        <Setter Property="FontSize" Value="21" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                        <Setter Property="Margin" Value="0,8,0,8" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCorner}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Win}" />
                                                                        <Setter Property="FontSize" Value="13" />
                                                                        <Setter Property="Margin" Value="0,7,0,5" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCrowd}" Value="True">
                                                                        <Setter Property="Foreground" Value="#E0A574" />
                                                                        <Setter Property="FontSize" Value="15" />
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPattern}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                                        <Setter Property="FontSize" Value="15" />
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                        <Setter Property="Margin" Value="0,6,0,4" />
                                                                    </DataTrigger>
                                                                    <!-- Where the fight is being fought. Sits between the plain action lines and the
                                                                         big shots: it is not an event, it is the shape the round is taking. -->
                                                                    <DataTrigger Binding="{Binding IsPosition}" Value="True">
                                                                        <Setter Property="Foreground" Value="#C0B49F" />
                                                                        <Setter Property="FontSize" Value="15" />
                                                                        <Setter Property="Margin" Value="0,4,0,2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <!-- The three cards, put up together once it is over. The call reads them out one at a
                             time and they are gone; this is the thing you actually look at. -->
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="10" Padding="20,14" Margin="0,0,0,14"
                                HorizontalAlignment="Center" MinWidth="420">
                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrue}">
                                    <Binding Path="PlaybackFinished" />
                                    <Binding Path="HasPlaybackCards" />
                                </MultiBinding>
                            </Border.Visibility>
                            <StackPanel>
                                <TextBlock Text="THE CARDS" Style="{StaticResource Label}"
                                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding PlaybackJudges}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Judge}" FontSize="12"
                                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Score}" FontSize="18"
                                                           FontFamily="Consolas" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Loss}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ForMe}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Win}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Verdict}" FontSize="12"
                                                           Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding PlaybackVerdict}" FontSize="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,0,0,14"
                                   Visibility="{Binding PlaybackFinished, Converter={StaticResource BoolVis}}" />

                        <!-- The rest of the show, with a word about each. His fight used to happen in an
                             empty building; then it happened on a card he could not read until afterwards. -->
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,14"
                                HorizontalAlignment="Center" MinWidth="460" MaxWidth="640">
                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrue}">
                                    <Binding Path="PlaybackFinished" />
                                    <Binding Path="HasUndercard" />
                                </MultiBinding>
                            </Border.Visibility>
                            <StackPanel>
                                <TextBlock Text="{Binding BillHeader}" Style="{StaticResource Label}"
                                           Foreground="{StaticResource Gold}" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Undercard}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Line}" FontSize="13"
                                                               Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Note}" FontSize="12"
                                                               Foreground="{StaticResource Faint}" Margin="0,2,0,0"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Verdict}" FontSize="12"
                                                           Foreground="{StaticResource Muted}" Margin="14,0,0,0"
                                                           VerticalAlignment="Top" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Watch it at your own pace: speed, pause, or jump to the end. Pausing lets the call
                             be scrolled back and read. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12"
                                    Visibility="{Binding PlaybackFinished, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <TextBlock Text="SPEED" Style="{StaticResource Label}" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Button Style="{StaticResource SpeedButton}" Content="0.5x" AutomationProperties.Name="Half speed"
                                    Command="{Binding SetSpeed}" CommandParameter="0.5"
                                    Tag="{Binding IsHalfSpeed, Converter={StaticResource OnOff}}" />
                            <Button Style="{StaticResource SpeedButton}" Content="1x" AutomationProperties.Name="Normal speed"
                                    Command="{Binding SetSpeed}" CommandParameter="1"
                                    Tag="{Binding IsNormalSpeed, Converter={StaticResource OnOff}}" />
                            <Button Style="{StaticResource SpeedButton}" Content="2x" AutomationProperties.Name="Double speed"
                                    Command="{Binding SetSpeed}" CommandParameter="2"
                                    Tag="{Binding IsDoubleSpeed, Converter={StaticResource OnOff}}" />
                            <Button Content="{Binding PauseLabel}" AutomationProperties.Name="{Binding PauseLabel}"
                                    Command="{Binding TogglePause}" Margin="14,0,0,0" Padding="18,7" FontSize="12" />
                            <Button Content="{Binding SoundLabel}" AutomationProperties.Name="{Binding SoundLabel}"
                                    Command="{Binding ToggleSound}" Margin="8,0,0,0" Padding="18,7" FontSize="12" />
                        </StackPanel>
                        <Button Command="{Binding FinishPlayback}" Style="{StaticResource PrimaryButton}"
                                Content="{Binding PlaybackButtonLabel}" Padding="30,12"
                                AutomationProperties.Name="{Binding PlaybackButtonLabel}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- A banner while the world is being simulated, so a pause is never silent. -->
            <Border Grid.ColumnSpan="2" Panel.ZIndex="20" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                    BorderThickness="1" CornerRadius="0,0,10,10" Padding="20,10"
                    Visibility="{Binding Busy, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding BusyMessage}" FontSize="13" Foreground="#CFE4FF" />
            </Border>

            <!-- ============ FIGHT NIGHT: THE WHOLE CARD ============ -->
            <!-- A card was a list read before the night and a list read after it, with the player's own bout
                 the only thing that happened. The bill runs in order now - openers first, his in its proper
                 place, whatever is above him afterwards - and there is no way out of the arena until the last
                 man has been out. It stands aside while his own fight is being called. -->
            <Grid Grid.ColumnSpan="2" Panel.ZIndex="10" Background="{StaticResource Bg}"
                  Visibility="{Binding CardOnScreen, Converter={StaticResource BoolVis}}">
                <Grid Margin="0,30,0,24" MaxWidth="820">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CardTitle}" Style="{StaticResource Label}"
                                   Foreground="{StaticResource Gold}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{Binding CardTonightNote}" FontSize="12" Margin="0,7,0,0"
                                   Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding CardTonightNote, Converter={StaticResource EmptyVis}}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                        <ItemsControl ItemsSource="{Binding CardNight}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="16,12" Margin="0,0,0,7" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Still to come: quiet. Now: lit. Fought: settled. -->
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Panel}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Panel2}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource GoldLine}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <!-- The place on the bill. The list is the poster, top to
                                                     bottom, and the night climbs it from the foot. -->
                                                <TextBlock Text="{Binding Slot}" FontSize="10" FontWeight="Bold"
                                                           Margin="0,0,0,3" Foreground="{StaticResource Faint}"
                                                           Visibility="{Binding HasSlot, Converter={StaticResource BoolVis}}" />
                                                <!-- Each corner, the way the poster reads it: who, where he is
                                                     from, and what he has done. This used to be the flat
                                                     "A vs B" string while the poster two screens away gave
                                                     both men their country and their record — and the night
                                                     you actually SIT THROUGH is the one that needs it most,
                                                     because seven unfamiliar names going past in order tell
                                                     you nothing about who is worth watching. Same BillLine
                                                     either way; only this template was ignoring the halves. -->
                                                <Grid>
                                                    <Grid.Resources>
                                                        <Style x:Key="Corner" TargetType="TextBlock">
                                                            <Setter Property="FontSize" Value="13" />
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Resources>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AName}" Style="{StaticResource Corner}" />
                                                        <TextBlock FontSize="11" Margin="0,2,0,0"
                                                                   Foreground="{StaticResource Faint}">
                                                            <Run Text="{Binding ACountry, Mode=OneWay}" />
                                                            <Run Text=" · " /><Run Text="{Binding ARecord, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="vs" FontSize="11" Margin="12,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Quiet}" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding BName}" Style="{StaticResource Corner}" />
                                                        <TextBlock FontSize="11" Margin="0,2,0,0"
                                                                   Foreground="{StaticResource Faint}">
                                                            <Run Text="{Binding BCountry, Mode=OneWay}" />
                                                            <Run Text=" · " /><Run Text="{Binding BRecord, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding Billing}" FontSize="11" Margin="0,3,0,0"
                                                           Foreground="{StaticResource Quiet}" TextWrapping="Wrap"
                                                           Visibility="{Binding HasBilling, Converter={StaticResource BoolVis}}" />
                                                <TextBlock Text="{Binding Note}" FontSize="12" Margin="0,4,0,0"
                                                           Foreground="{StaticResource Faint}" FontStyle="Italic"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Distance}" FontSize="12"
                                                           Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsPending, Converter={StaticResource BoolVis}}" />
                                                <TextBlock Text="{Binding Verdict}" FontSize="12"
                                                           Foreground="{StaticResource Gold}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}" />
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}">
                                                    <Button Content="{Binding DataContext.PlayLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Command="{Binding DataContext.PlayBout, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Style="{StaticResource PrimaryButton}" Padding="16,7" FontSize="12" />
                                                    <Button Content="Skip" Padding="14,7" FontSize="12" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.SkipBout, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ToolTip="Straight to the result" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- The only way out, and it is not there until the card is finished. -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,18,0,0"
                                Visibility="{Binding CardFinished, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="That is the card." FontSize="12" FontStyle="Italic"
                                   Foreground="{StaticResource Quiet}" HorizontalAlignment="Center" />
                        <Button Content="Leave the arena" Command="{Binding LeaveArena}"
                                Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                Padding="24,10" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>


            <!-- ============ NEWS DRAWER ============ -->
            <!-- The sport's news used to be a card at the foot of the dashboard, below the fold on a 1366-wide
                 screen and reachable from nowhere else without leaving the page you were on. It slides in from
                 the right now, over whatever you are reading, and carries the whole feed rather than six lines.
                 ClipToBounds is what keeps the closed drawer off screen instead of hanging past the edge. -->
            <Grid Grid.ColumnSpan="2" Panel.ZIndex="8" ClipToBounds="True"
                  Visibility="{Binding InPlay, Converter={StaticResource BoolVis}}">

                <!-- Click anywhere else to put it away. Only in the way while it is open. -->
                <Button Style="{StaticResource BackdropButton}" Command="{Binding CloseNewsDrawer}"
                        AutomationProperties.Name="Close the news"
                        Visibility="{Binding NewsOpen, Converter={StaticResource BoolVis}}" />

                <!-- The handle. Pinned to the right edge on every page, so the sport is always one click away
                     and never in the way. It goes when the drawer is out, because the drawer is its own close. -->
                <!-- Named for what it opens, not "News": the sidebar already has a nav item by that name, and
                     two controls with one name is ambiguous to a screen reader and to anything driving the UI. -->
                <Button Command="{Binding ToggleNews}" AutomationProperties.Name="Around the sport"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,0,0" Cursor="Hand"
                        Visibility="{Binding NewsOpen, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1,1,0,1" CornerRadius="9,0,0,9" Padding="11,9,9,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="c" Text="‹" FontSize="13" Foreground="{StaticResource Quiet}"
                                               VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock x:Name="t" Text="NEWS" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Quiet}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldLine}" />
                                    <Setter TargetName="t" Property="Foreground" Value="{StaticResource Gold}" />
                                    <Setter TargetName="c" Property="Foreground" Value="{StaticResource Gold}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border Width="430" HorizontalAlignment="Right" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"
                        IsHitTestVisible="{Binding NewsOpen}">
                    <Border.RenderTransform>
                        <TranslateTransform X="430" />
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NewsOpen}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                                 To="0" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                                 To="430" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />   <!-- heading -->
                            <RowDefinition Height="Auto" />   <!-- filters -->
                            <RowDefinition Height="*" />      <!-- the feed -->
                        </Grid.RowDefinitions>

                        <Grid Margin="20,18,14,12">
                            <StackPanel>
                                <TextBlock Text="AROUND THE SPORT" Style="{StaticResource Label}" />
                                <TextBlock Text="Every division, most recent first" FontSize="11"
                                           Foreground="{StaticResource Faint}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource CloseXButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Command="{Binding CloseNewsDrawer}"
                                    AutomationProperties.Name="Close the news" />
                        </Grid>

                        <!-- The same two filters as the News page, stacked because 430px will not take a row.
                             They share the state, so narrowing here narrows there. -->
                        <StackPanel Grid.Row="1" Margin="20,0,16,12" DataContext="{Binding NewsPage}">
                            <ComboBox ItemsSource="{Binding NewsDivisions}" SelectedItem="{Binding NewsDivision}"
                                      AutomationProperties.Name="Division in the news" />
                            <Grid Margin="0,9,0,0">
                                <CheckBox Content="Title fights only" IsChecked="{Binding NewsTitlesOnly}"
                                          VerticalAlignment="Center" />
                                <Button Content="Clear" Command="{Binding ClearNewsFilter}" Padding="10,4"
                                        FontSize="11" HorizontalAlignment="Right"
                                        Visibility="{Binding NewsIsFiltered, Converter={StaticResource BoolVis}}" />
                            </Grid>
                            <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource Muted}"
                                       Text="Nothing matches that. Try another division, or clear the filter."
                                       Visibility="{Binding NewsIsEmpty, Converter={StaticResource BoolVis}}" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,14"
                                      DataContext="{Binding NewsPage}">
                            <ItemsControl ItemsSource="{Binding News}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- A headline about a fight is a way into that fight, the same as on the
                                             News page. The rest stays plain text so only the openable ones ask. -->
                                        <Button Style="{StaticResource RowButton}" HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Text}"
                                                Command="{Binding DataContext.WatchNews, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                IsHitTestVisible="{Binding CanWatch}">
                                            <StackPanel Margin="20,7,16,7">
                                                <Grid>
                                                    <TextBlock Text="{Binding Date}" FontSize="11"
                                                               Foreground="{StaticResource Faint}" />
                                                    <TextBlock Text="watch ›" FontSize="11" HorizontalAlignment="Right"
                                                               Foreground="{StaticResource Gold}"
                                                               Visibility="{Binding CanWatch, Converter={StaticResource BoolVis}}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap"
                                                           Margin="0,3,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PlayerBout}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ AWARD CITATION (overlay) ============ -->
            <!-- Above the year-end awards panel (12), not below it: the honours are announced there and each
                 one opens its citation, so a citation stacked underneath would have opened invisibly. Closing
                 it drops back to the panel with the other three still waiting to be read. -->
            <Grid Grid.ColumnSpan="2" Panel.ZIndex="13"
                  Visibility="{Binding HasAward, Converter={StaticResource BoolVis}}">
                <Button Style="{StaticResource BackdropButton}" Command="{Binding CloseAward}"
                        AutomationProperties.Name="Close" />
                <Border Style="{StaticResource Card}" Width="560" Padding="0"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        DataContext="{Binding SelectedAward}">
                    <Grid>
                        <Button Style="{StaticResource CloseXButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="3"
                                AutomationProperties.Name="Close"
                                Command="{Binding DataContext.CloseAward, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <StackPanel Margin="24,22,24,22">
                            <TextBlock Text="{Binding Heading}" Style="{StaticResource Label}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Style="{StaticResource Tag}" BorderBrush="{StaticResource GoldLine}">
                                    <TextBlock Text="{Binding Position}" Style="{StaticResource TagText}"
                                               Foreground="{StaticResource Gold}" />
                                </Border>
                                <TextBlock Text="{Binding Division}" Style="{StaticResource TagText}"
                                           Foreground="{StaticResource Faint}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Light"
                                       Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,0"
                                    Visibility="{Binding HasCommentary, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding Commentary}" FontSize="13" LineHeight="21"
                                       Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,16,0,0"
                                       Visibility="{Binding HasCommentary, Converter={StaticResource BoolVis}}" />
                            <!-- An award is a claim about a night. The night itself is one click away, rebuilt
                                 asking for the most dramatic version that still fits the record — so a fight
                                 named Fight of the Year plays like one. -->
                            <Button Content="▶  Watch this fight" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Margin="0,20,0,0"
                                    AutomationProperties.Name="Watch this fight"
                                    Visibility="{Binding CanWatch, Converter={StaticResource BoolVis}}"
                                    Command="{Binding DataContext.WatchAward, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="{Binding OpenFighterLabel}"
                                        AutomationProperties.Name="{Binding OpenFighterLabel}"
                                        Visibility="{Binding CanOpenFighter, Converter={StaticResource BoolVis}}"
                                        Command="{Binding DataContext.OpenAwardFighter, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Grid.Column="2" Content="Close  (Esc)" AutomationProperties.Name="Close"
                                        Padding="26,10"
                                        Command="{Binding DataContext.CloseAward, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ FIGHT DETAIL (overlay) ============ -->
            <Grid Grid.ColumnSpan="2" Panel.ZIndex="10"
                  Visibility="{Binding HasFight, Converter={StaticResource BoolVis}}">
                <Button Style="{StaticResource BackdropButton}" Command="{Binding CloseFight}"
                        AutomationProperties.Name="Close" />
                <Border Style="{StaticResource Card}" Width="700" MaxHeight="800" Padding="0"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        DataContext="{Binding SelectedFight}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button Style="{StaticResource CloseXButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="3"
                                AutomationProperties.Name="Close"
                                Command="{Binding DataContext.CloseFight, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <StackPanel Margin="24,22,24,14">
                            <TextBlock Text="{Binding Opponent}" FontSize="21" FontWeight="Light"
                                       Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Verdict}" FontSize="15" Margin="0,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Win}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Win}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Loss}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Loss}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="{Binding Date}" FontSize="12" Foreground="{StaticResource Faint}" />
                                <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource Faint}"
                                           Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                                <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource Gold}"
                                           Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                            </StackPanel>

                            <!-- Any fight in the record books can be watched, not just the player's own. The
                                 world resolves most bouts statistically, so this rebuilds the night from the
                                 result before playing it. -->
                            <Button Content="▶  Watch this fight" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Margin="0,14,0,0"
                                    AutomationProperties.Name="Watch this fight"
                                    Command="{Binding DataContext.WatchFight, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <TextBlock Text="{Binding DataContext.WatchUnavailable, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="12" Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding DataContext.HasWatchProblem, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Totals for the bout -->
                                <ItemsControl ItemsSource="{Binding Totals}" Margin="16,0,16,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                                                    BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource Faint}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="Light"
                                                               Foreground="{StaticResource Text}" Margin="0,5,0,0" />
                                                    <TextBlock Text="{Binding Note}" FontSize="11"
                                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding NoRoundsNote}" FontSize="13" Margin="24,14,24,14"
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                           Visibility="{Binding HasRounds, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />

                                <StackPanel Visibility="{Binding HasRounds, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="ROUND BY ROUND" Style="{StaticResource PanelHeader}" Margin="24,12,24,4" />
                                    <Grid Margin="24,0,24,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="RD" Style="{StaticResource TagText}" Foreground="{StaticResource Faint}" />
                                        <TextBlock Grid.Column="1" Text="SCORE" Style="{StaticResource TagText}" Foreground="{StaticResource Faint}" />
                                        <TextBlock Grid.Column="2" Text="SHARE OF PUNCHES LANDED" Style="{StaticResource TagText}" Foreground="{StaticResource Faint}" />
                                        <TextBlock Grid.Column="3" Text="LANDED" Style="{StaticResource TagText}" Foreground="{StaticResource Faint}" />
                                        <TextBlock Grid.Column="4" Text="KD" Style="{StaticResource TagText}" Foreground="{StaticResource Faint}" />
                                    </Grid>
                                    <!-- Bottom-aligned: with finished rounds folded away the call is short, and
                                 growing upward from a fixed point reads far better than floating in a void. -->
                            <ItemsControl ItemsSource="{Binding Rounds}" VerticalAlignment="Bottom">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="24,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="60" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Round}" FontSize="12"
                                                               Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Score}" FontSize="13"
                                                               FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding WonRound}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- How the round's punches split, at a glance. Both halves are a
                                                         man, so the remainder is his colour rather than empty track. -->
                                                    <Grid x:Name="Track" Grid.Column="2" Height="8" VerticalAlignment="Center"
                                                          Margin="0,0,14,0">
                                                        <Border Background="{StaticResource Foe}" CornerRadius="4" />
                                                        <Border HorizontalAlignment="Left" CornerRadius="4"
                                                                Background="{StaticResource Accent}">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource BarWidth}">
                                                                    <Binding Path="ShareFor" />
                                                                    <Binding Path="ActualWidth" ElementName="Track" />
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Grid.Column="3" Text="{Binding Landed}" FontSize="12"
                                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Knockdowns}" FontSize="12"
                                                               FontWeight="Bold" Foreground="{StaticResource Gold}"
                                                               VerticalAlignment="Center" />
                                                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="5" Margin="46,3,0,7"
                                                                  ItemsSource="{Binding Commentary}"
                                                                  Visibility="{Binding HasCommentary, Converter={StaticResource BoolVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                                           Margin="0,0,0,2">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Converter={StaticResource Shout}}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- The three cards broken out. A bare "116-112 · 115-113 · 114-114" is the raw
                                     data; split up you can see that two had it close and one had it wide, or
                                     that a man was a single point from a draw. -->
                                <StackPanel Visibility="{Binding HasJudges, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="THE CARDS" Style="{StaticResource PanelHeader}" Margin="24,14,24,4" />
                                    <ItemsControl ItemsSource="{Binding Judges}" Margin="24,0,24,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="74" />
                                                        <ColumnDefinition Width="78" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Judge}" FontSize="12"
                                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Score}" FontSize="15"
                                                               FontFamily="Consolas" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ForMe}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Win}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Text="{Binding Verdict}" FontSize="11"
                                                               Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasCommentary, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="OTHER NOTES" Style="{StaticResource PanelHeader}" Margin="24,14,24,4" />
                                    <ItemsControl ItemsSource="{Binding Commentary}" Margin="24,0,24,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap"
                                                           Foreground="{StaticResource Muted}" Margin="0,3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2" Content="Close  (Esc)" AutomationProperties.Name="Close" Margin="24,12,24,22"
                                Command="{Binding DataContext.CloseFight, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ FIGHTER CARD (overlay) ============ -->
            <!-- The year's honours, announced. A year of the sport ending is an occasion; these used to be
                 computed the moment the calendar turned and filed on a page you had to go and look at. -->
            <Grid Grid.ColumnSpan="2" Panel.ZIndex="12"
                  Visibility="{Binding ShowYearAwards, Converter={StaticResource BoolVis}}">
                <Border Background="#CC080706" />
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource GoldLine}"
                        BorderThickness="1" CornerRadius="14" Padding="30,26" MaxWidth="620"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding YearAwardsTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Gold}" HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="The year in the sport, and who took it"
                                   FontSize="12" Foreground="{StaticResource Faint}"
                                   HorizontalAlignment="Center" Margin="0,0,0,20" />

                        <ItemsControl ItemsSource="{Binding YearAwards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Each honour opens its citation, the same as on the Awards page. Being
                                         told who won the year and not being able to ask about it was the one
                                         dead end left in the announcement. -->
                                    <Button Style="{StaticResource RowButton}" ToolTip="Read the citation"
                                            AutomationProperties.Name="{Binding Name}"
                                            Command="{Binding DataContext.ShowAward, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                    <Border BorderThickness="1" CornerRadius="9" Padding="16,12" Margin="0,0,0,9">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Panel2}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                                <Style.Triggers>
                                                    <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}">
                                                        <Setter Property="BorderBrush" Value="{StaticResource GoldLine}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Position}" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Gold}" />
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Light"
                                                       Foreground="{StaticResource Text}" Margin="0,5,0,0"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                                       Foreground="{StaticResource Muted}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Commentary}" FontSize="12"
                                                       Foreground="{StaticResource Faint}" Margin="0,5,0,0"
                                                       TextWrapping="Wrap" FontStyle="Italic"
                                                       Visibility="{Binding Commentary, Converter={StaticResource EmptyVis}}" />
                                        </StackPanel>
                                    </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="On with it" Command="{Binding CloseYearAwards}"
                                Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Padding="16,9" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.ColumnSpan="2"
                  Visibility="{Binding HasCard, Converter={StaticResource BoolVis}}">
                <Button Style="{StaticResource BackdropButton}" Command="{Binding CloseCard}"
                        AutomationProperties.Name="Close" />


                <Border Style="{StaticResource Card}" Width="620" MaxHeight="760" Padding="0"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        DataContext="{Binding SelectedCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button Style="{StaticResource CloseXButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="3"
                                AutomationProperties.Name="Close"
                                Command="{Binding DataContext.CloseCard, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Grid Margin="24,22,24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="12" Width="62" Height="48" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Class}" FontSize="26" FontWeight="Light"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Class, Converter={StaticResource ClassColour}}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Light"
                                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Record}" FontSize="13" Foreground="{StaticResource Muted}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource Faint}"
                                           Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Belts}" FontSize="12" Foreground="{StaticResource Gold}"
                                           Margin="0,5,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding Belts, Converter={StaticResource EmptyVis}}" />
                                <!-- What kind of fighter he is. It has driven every exchange he has ever had;
                                     it should not take reading his attributes to work it out. -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding Style, Converter={StaticResource EmptyVis}}">
                                    <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                                            BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Style}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#CFE4FF" />
                                    </Border>
                                    <TextBlock Text="{Binding StyleNote}" FontSize="11" Margin="9,0,0,0"
                                               Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" MaxWidth="330" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Wind the card back. A faded champion's ratings today say nothing about the
                                     fighter who won the title, so the attributes, the arsenal and the derived
                                     numbers can all be read at any point of his career. -->
                                <Grid Margin="24,10,24,2"
                                      Visibility="{Binding HasArc, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SHOWING" Style="{StaticResource Label}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Arc}"
                                              SelectedItem="{Binding SelectedStage, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              AutomationProperties.Name="Career stage" />
                                </Grid>
                                <TextBlock Text="{Binding StageNote}" FontSize="11" Margin="24,2,24,0"
                                           Foreground="{StaticResource Gold}" TextWrapping="Wrap"
                                           Visibility="{Binding IsHistoric, Converter={StaticResource BoolVis}}" />

                                <TextBlock Text="ATTRIBUTES · 1–15" Style="{StaticResource PanelHeader}" Margin="24,4,24,8"
                                           Visibility="{Binding HasRatings, Converter={StaticResource BoolVis}}" />
                                <ItemsControl ItemsSource="{Binding Ratings}" Margin="24,0,24,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,14,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="98" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Muted}" />
                                                <Grid x:Name="Track" Grid.Column="1" Height="7" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource Line}" CornerRadius="3.5" />
                                                    <Border HorizontalAlignment="Left" CornerRadius="3.5"
                                                            Background="{StaticResource Accent}">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource BarWidth}">
                                                                <Binding Path="Width" />
                                                                <Binding Path="ActualWidth" ElementName="Track" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- ARSENAL. Which punches he actually throws. Two men on identical ratings
                                     fight nothing alike if one lives behind a jab and the other digs to the
                                     body, and this is the same distribution the engine picks his shots from. -->
                                <TextBlock Text="ARSENAL" Style="{StaticResource PanelHeader}" Margin="24,14,24,4"
                                           Visibility="{Binding HasArsenal, Converter={StaticResource BoolVis}}" />
                                <ItemsControl ItemsSource="{Binding Arsenal}" Margin="24,0,24,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="38" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Muted}" />
                                                <Grid x:Name="ATrack" Grid.Column="1" Height="7" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource Line}" CornerRadius="3.5" />
                                                    <Border HorizontalAlignment="Left" CornerRadius="3.5"
                                                            Background="{Binding Colour}">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource BarWidth}">
                                                                <Binding Path="Width" />
                                                                <Binding Path="ActualWidth" ElementName="ATrack" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0}%}"
                                                           FontSize="11" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" Foreground="{StaticResource Text}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- What his attributes ADD UP TO. Killer instinct, durability, recovery,
                                     pressure and countering are each a blend of several ratings, and they are
                                     what people actually describe a fighter with. -->
                                <TextBlock Text="DERIVED · 1–15" Style="{StaticResource PanelHeader}" Margin="24,14,24,4"
                                           Visibility="{Binding HasSecondary, Converter={StaticResource BoolVis}}" />
                                <ItemsControl ItemsSource="{Binding Secondary}" Margin="24,0,24,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,14,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="98" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Muted}" />
                                                <Grid x:Name="STrack" Grid.Column="1" Height="7" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource Line}" CornerRadius="3.5" />
                                                    <Border HorizontalAlignment="Left" CornerRadius="3.5"
                                                            Background="{Binding Value, Converter={StaticResource ClassColour}}">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource BarWidth}">
                                                                <Binding Path="Width" />
                                                                <Binding Path="ActualWidth" ElementName="STrack" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- What the ledger says, which no 1-15 bar can: how he finishes, whether he
                                     has ever been stopped, and the volume he works at. -->
                                <TextBlock Text="FORM" Style="{StaticResource PanelHeader}" Margin="24,14,24,4"
                                           Visibility="{Binding HasForm, Converter={StaticResource BoolVis}}" />
                                <ItemsControl ItemsSource="{Binding Form}" Margin="24,0,24,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4,14,8">
                                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Faint}" />
                                                <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="Light"
                                                           Foreground="{StaticResource Text}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{StaticResource Muted}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="FIGHT RECORD" Style="{StaticResource PanelHeader}" Margin="24,10,24,4" />
                                <!-- Why a 29-1-0 man can show two fights. -->
                                <TextBlock Text="{Binding RecordNote}" FontSize="11" Margin="24,0,24,6"
                                           Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                                           Visibility="{Binding RecordNote, Converter={StaticResource EmptyVis}}" />
                                <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource LedgerRowTemplate}"
                                              Margin="6,0,6,8" />
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="24,12,24,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Follow him to his own division rather than closing and hunting for it. -->
                            <Button Content="{Binding DivisionLink}" AutomationProperties.Name="{Binding DivisionLink}"
                                    Visibility="{Binding HasDivisionLink, Converter={StaticResource BoolVis}}"
                                    Command="{Binding DataContext.ViewDivisionCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Division}" />
                            <Button Grid.Column="2" Content="Close  (Esc)" AutomationProperties.Name="Close" Padding="26,10"
                                    Command="{Binding DataContext.CloseCard, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
