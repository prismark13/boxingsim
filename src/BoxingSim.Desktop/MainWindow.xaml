<Window x:Class="BoxingSim.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BoxingSim.Desktop"
        Title="BoxingSim" Height="900" Width="1450" MinHeight="640" MinWidth="1080"
        Background="{StaticResource Bg}" TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI" UseLayoutRounding="True">

    <Window.Resources>
        <local:ClassColourConverter x:Key="ClassColour" />
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <local:EmptyToVisibilityConverter x:Key="EmptyVis" />

        <!-- A rating pill: the 1-15 class, coloured by tier. -->
        <DataTemplate x:Key="ClassPill">
            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Width="44" Height="32">
                <TextBlock Text="{Binding Class}" FontWeight="Bold" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding Class, Converter={StaticResource ClassColour}}" />
            </Border>
        </DataTemplate>

        <!-- One fighter in a ranking list. -->
        <DataTemplate x:Key="RankRowTemplate">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Rank}" Foreground="{StaticResource Faint}" FontWeight="SemiBold"
                           FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ClassPill}"
                                  HorizontalAlignment="Left" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontWeight="SemiBold"
                               FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11.5"
                               Margin="0,3,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Detail, Converter={StaticResource EmptyVis}}" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding Record}" Foreground="{StaticResource Muted}"
                           FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ============================ SETUP ============================ -->
        <!-- HorizontalScrollBarVisibility must be Disabled or the ScrollViewer measures its content with infinite
             width, and HorizontalAlignment="Center" then centres against the extent instead of the viewport. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding InCareer, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <Border Style="{StaticResource Card}" Width="560" Padding="34" Margin="0,48,0,48"
                    VerticalAlignment="Top" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="BOXINGSIM" FontSize="26" FontWeight="Light" Foreground="{StaticResource Text}"
                               />
                    <TextBlock Text="Take a fighter from his debut to the Hall of Fame" FontSize="13"
                               Foreground="{StaticResource Muted}" Margin="0,8,0,26" />

                    <TextBlock Text="FIGHTER" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Roll" Command="{Binding RollName}" Margin="8,0,0,0"
                                Padding="14,7" />
                    </Grid>

                    <TextBlock Text="COUNTRY" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <ComboBox ItemsSource="{Binding Countries}" SelectedItem="{Binding Country}" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="START YEAR" Style="{StaticResource Label}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SetupYear}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DIVISION" Style="{StaticResource Label}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Divisions}" SelectedItem="{Binding SetupDivision}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="TALENT" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <ComboBox ItemsSource="{Binding Talents}" SelectedItem="{Binding Talent}" />

                    <CheckBox Content="Simulate full history (seeds the Hall of Fame with past greats)"
                              IsChecked="{Binding FullHistory}" Margin="0,20,0,0" />

                    <Button Content="Start career" Command="{Binding StartCareer}"
                            Style="{StaticResource PrimaryButton}" Margin="0,26,0,0" />
                    <Button Content="Continue saved career" Command="{Binding ContinueCareer}" Margin="0,10,0,0" />

                    <TextBlock Text="Simulating the world — this can take a moment." FontSize="12"
                               Foreground="{StaticResource Accent}" Margin="0,14,0,0" HorizontalAlignment="Center"
                               Visibility="{Binding Busy, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding SaveLocation, StringFormat=Saves to {0}}" FontSize="11"
                               Foreground="{StaticResource Faint}" Margin="0,18,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ============================ CAREER ============================ -->
        <Grid Visibility="{Binding InCareer, Converter={StaticResource BoolVis}}" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="420" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <Border Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="12" Width="70" Height="54" Margin="0,0,16,0">
                        <TextBlock Text="{Binding PlayerClass}" FontSize="26" FontWeight="Light"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding PlayerClass, Converter={StaticResource ClassColour}}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlayerHeadline}" FontSize="21" FontWeight="Light"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding PlayerMeta}" FontSize="12.5" Foreground="{StaticResource Muted}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding DateLabel}" FontSize="13" Foreground="{StaticResource Text}"
                                   HorizontalAlignment="Right" />
                        <Button Content="Abandon career" Command="{Binding AbandonCareer}" Margin="0,8,0,0"
                                Padding="12,6" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- LEFT: fight night, result, ledger, news -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Result banner -->
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding ResultHeadline}" FontSize="15" TextWrapping="Wrap"
                                   Foreground="{StaticResource Text}" />
                    </Border>

                    <!-- The offer -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"
                            Visibility="{Binding HasOffer, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}">
                                <Run Text="FIGHT NIGHT · " /><Run Text="{Binding OfferDateLabel, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding OfferContext, Mode=OneWay}" />
                            </TextBlock>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="8" Width="48" Height="36" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding OfferOpponentClass}" FontWeight="Bold" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding OfferOpponentClass, Converter={StaticResource ClassColour}}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OfferOpponent}" FontSize="18"
                                               Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding OfferDetail}" FontSize="12"
                                               Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Take the fight" Command="{Binding TakeFight}"
                                        Style="{StaticResource PrimaryButton}" />
                                <Button Grid.Column="2" Content="Hold out" Command="{Binding HoldOut}" />
                            </Grid>
                            <Button Content="{Binding MoveUpLabel}" Command="{Binding MoveUp}" Margin="0,10,0,0"
                                    Padding="12,7" FontSize="12"
                                    Visibility="{Binding MoveUpLabel, Converter={StaticResource EmptyVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Retired -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"
                            Visibility="{Binding PlayerRetired, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="This career is over. Start a new one to fight again."
                                   Foreground="{StaticResource Muted}" FontSize="13" />
                    </Border>

                    <!-- Ledger -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="FIGHT RECORD" Style="{StaticResource PanelHeader}" />
                            <ItemsControl ItemsSource="{Binding Ledger}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="16,8" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Date}" FontSize="11"
                                                       Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Result}" FontWeight="Bold"
                                                       FontSize="12" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Win}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Win}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Loss}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Loss}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Opponent}" FontSize="13"
                                                           Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- News -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="NEWS" Style="{StaticResource PanelHeader}" />
                            <ItemsControl ItemsSource="{Binding News}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="16,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Date}" FontSize="11"
                                                       Foreground="{StaticResource Faint}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlayerBout}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: the boards -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel x:Name="Tabs" Margin="14,14,14,10">
                        <RadioButton x:Name="TabRankings" Style="{StaticResource TabButton}" Content="Rankings" IsChecked="True" />
                        <RadioButton x:Name="TabP4P" Style="{StaticResource TabButton}" Content="Pound-for-pound" />
                        <RadioButton x:Name="TabDivisions" Style="{StaticResource TabButton}" Content="Champions" />
                        <RadioButton x:Name="TabHof" Style="{StaticResource TabButton}" Content="Hall of Fame" />
                        <RadioButton x:Name="TabAwards" Style="{StaticResource TabButton}" Content="Awards" />
                    </WrapPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Rankings}" ItemTemplate="{StaticResource RankRowTemplate}"
                                          Visibility="{Binding IsChecked, ElementName=TabRankings, Converter={StaticResource BoolVis}}" />

                            <ItemsControl ItemsSource="{Binding PoundForPound}" ItemTemplate="{StaticResource RankRowTemplate}"
                                          Visibility="{Binding IsChecked, ElementName=TabP4P, Converter={StaticResource BoolVis}}" />

                            <ItemsControl ItemsSource="{Binding HallOfFame}"
                                          Visibility="{Binding IsChecked, ElementName=TabHof, Converter={StaticResource BoolVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="16,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Rank}" Foreground="{StaticResource Faint}"
                                                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <ContentPresenter Grid.Column="1" Content="{Binding}"
                                                              ContentTemplate="{StaticResource ClassPill}" HorizontalAlignment="Left" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{StaticResource Text}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                           Foreground="{StaticResource Muted}" Margin="0,3,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Record}" FontSize="12"
                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                                       Margin="12,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Champions board: a block per division, the lineal/Ring line picked out in gold. -->
                            <ItemsControl ItemsSource="{Binding Champions}"
                                          Visibility="{Binding IsChecked, ElementName=TabDivisions, Converter={StaticResource BoolVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" Margin="16,14,16,8">
                                                <TextBlock Text="{Binding Division}" Style="{StaticResource Label}"
                                                           Foreground="{StaticResource Text}" />
                                                <Border Style="{StaticResource Tag}" BorderBrush="{StaticResource GoldLine}"
                                                        Margin="9,0,0,0"
                                                        Visibility="{Binding Undisputed, Converter={StaticResource EmptyVis}}">
                                                    <TextBlock Text="{Binding Undisputed}" Style="{StaticResource TagText}"
                                                               Foreground="{StaticResource Gold}" />
                                                </Border>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Belts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="12,2" CornerRadius="8" Padding="6,5">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Lineal}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource GoldSoft}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="58" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Belt}" FontSize="9"
                                                                           FontWeight="Bold" VerticalAlignment="Center"
                                                                          >
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Lineal}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="{Binding Holder}"
                                                                           FontSize="13" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Vacant}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                                           FontSize="11.5" Foreground="{StaticResource Muted}"
                                                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Awards: the top three across, winner picked out. -->
                            <ItemsControl ItemsSource="{Binding Awards}"
                                          Visibility="{Binding IsChecked, ElementName=TabAwards, Converter={StaticResource BoolVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="16,14,16,4">
                                            <TextBlock Style="{StaticResource Label}">
                                                <Run Text="{Binding Year, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Category, Mode=OneWay}" />
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Places}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="3" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="10" Padding="12" Margin="0,0,8,8"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource Panel2}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Winner}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource GoldSoft}" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource GoldLine}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Position}" FontSize="9"
                                                                           FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Winner}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           FontSize="13.5" Foreground="{StaticResource Text}"
                                                                           TextWrapping="Wrap" Margin="0,5,0,0" />
                                                                <TextBlock Text="{Binding Division}" FontSize="9"
                                                                           FontWeight="Bold" Foreground="{StaticResource Faint}"
                                                                           Margin="0,4,0,0" />
                                                                <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                                           Foreground="{StaticResource Muted}"
                                                                           TextWrapping="Wrap" Margin="0,5,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
