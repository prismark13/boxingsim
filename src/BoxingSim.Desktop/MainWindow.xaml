<Window x:Class="BoxingSim.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BoxingSim.Desktop"
        Title="BoxingSim" Height="920" Width="1500" MinHeight="660" MinWidth="1120"
        Background="{StaticResource Bg}" TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI" UseLayoutRounding="True">

    <!-- The app says when it is thinking: the pointer becomes a wait cursor and a banner names the work. -->
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Busy}" Value="True">
                    <Setter Property="Cursor" Value="Wait" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>


    <!-- Keyboard is the fastest way around a shell like this. Ctrl+1..8 jump straight to a page, Alt+Left goes
         back, Escape backs out of an overlay, Enter takes the fight you're being offered. -->
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Dashboard" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Career" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Stats" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Rankings" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="P4P" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Champions" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="News" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Hall" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="Awards" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding Navigate}" CommandParameter="About" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding GoBack}" />
        <KeyBinding Key="Back" Modifiers="Alt" Command="{Binding GoBack}" />
        <KeyBinding Key="Escape" Command="{Binding Dismiss}" />
        <KeyBinding Key="Enter" Command="{Binding TakeFight}" />
    </Window.InputBindings>

    <Window.Resources>
        <local:ClassColourConverter x:Key="ClassColour" />
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <local:EmptyToVisibilityConverter x:Key="EmptyVis" />
        <local:EnumToVisibilityConverter x:Key="PageVis" />
        <local:FractionWidthConverter x:Key="BarWidth" />
        <local:WeightClassNameConverter x:Key="DivName" />
        <local:ShoutConverter x:Key="Shout" />
        <local:OnOffConverter x:Key="OnOff" />

        <!-- Weight classes read as "Light Heavyweight", never the raw enum name. -->
        <DataTemplate x:Key="DivisionItem">
            <TextBlock Text="{Binding Converter={StaticResource DivName}}" />
        </DataTemplate>

        <DataTemplate x:Key="ClassPill">
            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Width="44" Height="32">
                <TextBlock Text="{Binding Class}" FontWeight="Bold" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding Class, Converter={StaticResource ClassColour}}" />
            </Border>
        </DataTemplate>

        <!-- A fighter row. Clicking anywhere on it opens his card. -->
        <DataTemplate x:Key="RankRowTemplate">
            <Button Style="{StaticResource RowButton}" AutomationProperties.Name="{Binding Name}"
                    Command="{Binding DataContext.ShowFighter, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid Margin="18,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Rank}" Foreground="{StaticResource Faint}" FontWeight="SemiBold"
                               FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ClassPill}"
                                      HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontWeight="SemiBold"
                                   FontSize="14.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11.5"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Detail, Converter={StaticResource EmptyVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Record}" Foreground="{StaticResource Muted}"
                                   FontSize="12" Margin="12,0,0,0" />
                        <TextBlock Text="›" Foreground="{StaticResource Faint}" FontSize="15" Margin="12,-2,0,0" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- A bout in a ledger. Clicking it opens the round-by-round card for that fight. -->
        <DataTemplate x:Key="LedgerRowTemplate">
            <Button Style="{StaticResource RowButton}" AutomationProperties.Name="{Binding Opponent}"
                    ToolTip="See the round-by-round card"
                    Command="{Binding DataContext.ShowFight, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid Margin="18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Date}" FontSize="11" Foreground="{StaticResource Faint}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Result}" FontWeight="Bold" FontSize="12"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Win}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Win}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Loss}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Loss}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Opponent}" FontSize="13" Foreground="{StaticResource Text}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="›" Foreground="{StaticResource Faint}" FontSize="15"
                               VerticalAlignment="Center" Margin="10,-2,0,0" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ============================ SETUP ============================ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding InCareer, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <Border Style="{StaticResource Card}" Width="560" Padding="34" Margin="0,48"
                    VerticalAlignment="Top" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="BOXINGSIM" FontSize="26" FontWeight="Light" Foreground="{StaticResource Text}" />
                    <TextBlock Text="Take a fighter from his debut to the Hall of Fame" FontSize="13"
                               Foreground="{StaticResource Muted}" Margin="0,8,0,26" />

                    <TextBlock Text="FIGHTER" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Roll" Command="{Binding RollName}" Margin="8,0,0,0"
                                Padding="14,7" />
                    </Grid>

                    <TextBlock Text="COUNTRY" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <ComboBox ItemsSource="{Binding Countries}" SelectedItem="{Binding Country}" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="START YEAR" Style="{StaticResource Label}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SetupYear}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DIVISION" Style="{StaticResource Label}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Divisions}" SelectedItem="{Binding SetupDivision}"
                                      ItemTemplate="{StaticResource DivisionItem}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="TALENT" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <ComboBox ItemsSource="{Binding Talents}" SelectedItem="{Binding Talent}" />

                    <CheckBox Content="Simulate full history (seeds the Hall of Fame with past greats)"
                              IsChecked="{Binding FullHistory}" Margin="0,20,0,0" />

                    <Button Content="Start career" Command="{Binding StartCareer}"
                            Style="{StaticResource PrimaryButton}" Margin="0,26,0,0" />
                    <Button Content="Continue saved career" Command="{Binding ContinueCareer}" Margin="0,10,0,0" />

                    <TextBlock Text="Reading the fighter roster…" FontSize="12"
                               Foreground="{StaticResource Accent}" Margin="0,14,0,0" HorizontalAlignment="Center"
                               Visibility="{Binding Loading, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding BusyMessage}" FontSize="12"
                               Foreground="{StaticResource Accent}" Margin="0,14,0,0" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding Busy, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding SaveLocation, StringFormat=Saves to {0}}" FontSize="11"
                               Foreground="{StaticResource Faint}" Margin="0,18,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ============================ APP SHELL ============================ -->
        <Grid Visibility="{Binding InCareer, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ SIDEBAR ============ -->
            <Border Background="#0B0F15" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Who you are -->
                    <StackPanel Margin="22,26,22,20">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="10" Width="52" Height="42">
                                <TextBlock Text="{Binding PlayerClass}" FontSize="21" FontWeight="Light"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding PlayerClass, Converter={StaticResource ClassColour}}" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlayerRecord}" FontSize="15" Foreground="{StaticResource Text}" />
                                <TextBlock Text="{Binding PlayerStanding}" FontSize="10.5" FontWeight="SemiBold"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlayerIsChampion}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding PlayerHeadline}" FontSize="20" FontWeight="Light"
                                   Foreground="{StaticResource Text}" Margin="0,14,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PlayerIdentity}" FontSize="11.5" Foreground="{StaticResource Faint}"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Where you're going -->
                    <StackPanel Grid.Row="1">
                        <!-- The glyph is decoration; the accessible name is the plain word. -->
                        <Button Content="← Back" AutomationProperties.Name="Back" Command="{Binding GoBack}"
                                Margin="24,0,24,10" Padding="10,6" FontSize="11.5" HorizontalAlignment="Left"
                                ToolTip="Alt+Left" />
                        <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}"
                                 ItemContainerStyle="{StaticResource NavItemStyle}" Margin="12,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="22,0,22,20">
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14" />
                        <TextBlock Text="{Binding DateLabel}" FontSize="12.5" Foreground="{StaticResource Text}" />
                        <Button Content="Abandon career" Command="{Binding AbandonCareer}" Margin="0,12,0,0"
                                Padding="10,7" FontSize="11" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ CONTENT ============ -->
            <Grid Grid.Column="1">

                <!-- ============ DASHBOARD: career mode's hub ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Dashboard}">
                    <StackPanel Margin="28,26,28,28" MaxWidth="1080">
                        <TextBlock Text="{Binding PlayerHeadline}" FontSize="24" FontWeight="Light"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding DateLabel}" FontSize="12" Foreground="{StaticResource Muted}"
                                   Margin="0,4,0,18" />

                        <!-- Headline numbers -->
                        <ItemsControl ItemsSource="{Binding Headlines}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,10,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="Light"
                                                       Foreground="{StaticResource Text}" Margin="0,7,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource Muted}"
                                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The next fight, taken from here without going anywhere -->
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,6,0,14"
                                Visibility="{Binding HasOffer, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <Border Background="#0F141C" CornerRadius="14,14,0,0" Padding="22,14">
                                    <TextBlock Style="{StaticResource Label}">
                                        <Run Text="YOUR NEXT FIGHT · " /><Run Text="{Binding OfferDateLabel, Mode=OneWay}" />
                                        <Run Text=" · " /><Run Text="{Binding OfferContext, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Grid Margin="22,18,22,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" CornerRadius="9" Width="52" Height="40" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding OfferOpponentClass}" FontWeight="Bold" FontSize="17"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding OfferOpponentClass, Converter={StaticResource ClassColour}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OfferOpponent}" FontSize="19"
                                                   Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0">
                                            <Run Text="{Binding OfferOpponentRecord, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding OfferRounds, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Take the fight" Command="{Binding TakeFight}"
                                                Style="{StaticResource PrimaryButton}" Padding="22,10" />
                                        <Button Content="Hold out" Command="{Binding HoldOut}" Margin="10,0,0,0" />
                                        <Button Content="Tale of the tape ›" Command="{Binding Navigate}"
                                                CommandParameter="Career" Margin="10,0,0,0" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Two columns of gateways into the fuller screens -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Button Style="{StaticResource RowButton}" Command="{Binding Navigate}"
                                                CommandParameter="Stats" AutomationProperties.Name="Recent form">
                                            <Grid Margin="18,14,18,10">
                                                <TextBlock Text="RECENT FORM" Style="{StaticResource Label}" />
                                                <TextBlock Text="my record ›" FontSize="11" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Accent}" />
                                            </Grid>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding RecentForm}"
                                                      ItemTemplate="{StaticResource LedgerRowTemplate}" />
                                        <TextBlock Text="No fights yet." Foreground="{StaticResource Faint}" FontSize="12"
                                                   Margin="18,4,18,16"
                                                   Visibility="{Binding HasLedger, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Button Style="{StaticResource RowButton}" Command="{Binding Navigate}"
                                                CommandParameter="Rankings" AutomationProperties.Name="Your division">
                                            <Grid Margin="18,14,18,10">
                                                <TextBlock Text="YOUR DIVISION" Style="{StaticResource Label}" />
                                                <TextBlock Text="full rankings ›" FontSize="11" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Accent}" />
                                            </Grid>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding DivisionTop}"
                                                      ItemTemplate="{StaticResource RankRowTemplate}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Button Style="{StaticResource RowButton}" Command="{Binding Navigate}"
                                        CommandParameter="News" AutomationProperties.Name="Latest news">
                                    <Grid Margin="18,14,18,10">
                                        <TextBlock Text="AROUND THE SPORT" Style="{StaticResource Label}" />
                                        <TextBlock Text="all news ›" FontSize="11" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource Accent}" />
                                    </Grid>
                                </Button>
                                <ItemsControl ItemsSource="{Binding HeadlineNews}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="18,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Date}" FontSize="11" Foreground="{StaticResource Faint}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PlayerBout}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="8" Background="Transparent" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ FIGHT NIGHT ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Career}">
                    <StackPanel Margin="28,26,28,28" MaxWidth="1000" HorizontalAlignment="Stretch">

                        <!-- Hidden while the playback overlay is up: showing the verdict behind it gives the
                             result away before the rounds have been watched. -->
                        <Border Style="{StaticResource Card}" Padding="20,15" Margin="0,0,0,16"
                                Visibility="{Binding ShowResultBanner, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding ResultHeadline}" FontSize="15.5" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastBoutWon}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Win}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LastBoutLost}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Loss}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- The fight, as a poster -->
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16"
                                Visibility="{Binding HasOffer, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <Border Background="#0F141C" CornerRadius="14,14,0,0" Padding="24,16">
                                    <TextBlock Style="{StaticResource Label}">
                                        <Run Text="FIGHT NIGHT · " /><Run Text="{Binding OfferDateLabel, Mode=OneWay}" />
                                        <Run Text=" · " /><Run Text="{Binding OfferContext, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>

                                <Grid Margin="24,22,24,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PlayerHeadline}" FontSize="21" FontWeight="Light"
                                                   Foreground="{StaticResource Text}" HorizontalAlignment="Center"
                                                   TextWrapping="Wrap" TextAlignment="Center" />
                                        <TextBlock Text="{Binding PlayerRecord}" FontSize="13"
                                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                                   Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding PlayerIdentity}" FontSize="11"
                                                   Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding PlayerFrame}" FontSize="11"
                                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="vs" FontSize="15" Foreground="{StaticResource Faint}"
                                               VerticalAlignment="Center" Margin="24,0" />
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding OfferOpponent}" FontSize="21" FontWeight="Light"
                                                   Foreground="{StaticResource Text}" HorizontalAlignment="Center"
                                                   TextWrapping="Wrap" TextAlignment="Center" />
                                        <TextBlock Text="{Binding OfferOpponentRecord}" FontSize="13"
                                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                                   Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding OfferOpponentMeta}" FontSize="11"
                                                   Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding OfferOpponentFrame}" FontSize="11"
                                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding OfferRounds}" FontSize="11.5" Foreground="{StaticResource Faint}"
                                           HorizontalAlignment="Center" Margin="0,10,0,0" />

                                <!-- Tale of the tape -->
                                <TextBlock Text="TALE OF THE TAPE · 1–15" Style="{StaticResource Label}"
                                           Margin="24,20,24,10" HorizontalAlignment="Center" />
                                <ItemsControl ItemsSource="{Binding Tape}" Margin="24,0,24,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- mine, growing right-to-left -->
                                                <Grid x:Name="MineTrack" Grid.Column="0" Height="16">
                                                    <Border HorizontalAlignment="Right" CornerRadius="3"
                                                            Background="{StaticResource Accent}">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource BarWidth}">
                                                                <Binding Path="MineWidth" />
                                                                <Binding Path="ActualWidth" ElementName="MineTrack" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                    <TextBlock Text="{Binding Mine}" FontSize="10.5" Margin="0,0,7,0"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="#04121F" FontWeight="Bold" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding Attribute}" FontSize="10.5"
                                                           FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Grid x:Name="TheirsTrack" Grid.Column="2" Height="16">
                                                    <Border HorizontalAlignment="Left" CornerRadius="3"
                                                            Background="{StaticResource Line2}">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource BarWidth}">
                                                                <Binding Path="TheirsWidth" />
                                                                <Binding Path="ActualWidth" ElementName="TheirsTrack" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                    <TextBlock Text="{Binding Theirs}" FontSize="10.5" Margin="7,0,0,0"
                                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                                               Foreground="{StaticResource Text}" FontWeight="Bold" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="24,20,24,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Take the fight" Command="{Binding TakeFight}"
                                            Style="{StaticResource PrimaryButton}" />
                                    <Button Grid.Column="2" Content="Hold out" Command="{Binding HoldOut}" />
                                </Grid>
                                <Button Content="{Binding MoveUpLabel}" Command="{Binding MoveUp}"
                                        Margin="24,0,24,22" Padding="12,8" FontSize="12"
                                        Visibility="{Binding MoveUpLabel, Converter={StaticResource EmptyVis}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16"
                                Visibility="{Binding PlayerRetired, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="This career is over. Start a new one to fight again."
                                       Foreground="{StaticResource Muted}" FontSize="13" />
                        </Border>

                        <Border Style="{StaticResource Card}"
                                Visibility="{Binding HasLedger, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="FIGHT RECORD" Style="{StaticResource PanelHeader}" />
                                <ItemsControl ItemsSource="{Binding Ledger}" ItemTemplate="{StaticResource LedgerRowTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ LIST PAGES ============ -->
                <!-- Rankings can show ANY division, not just the player's — otherwise following a fighter to his
                     own division was impossible without abandoning the page. -->
                <Grid Margin="28,26,28,28"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Rankings}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RANKINGS" FontSize="19" FontWeight="Light"
                                       Foreground="{StaticResource Text}" />
                            <TextBlock Text="{Binding RankingsSubtitle}" FontSize="12"
                                       Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="210" VerticalAlignment="Center"
                                  ItemsSource="{Binding RankingDivisions}" SelectedItem="{Binding ViewDivision}"
                                  ItemTemplate="{StaticResource DivisionItem}" />
                    </Grid>
                    <!-- Say plainly when you're reading somebody else's division, with the way home. -->
                    <Border Grid.Row="1" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                            BorderThickness="1" CornerRadius="9" Padding="14,9" Margin="0,0,0,12"
                            Visibility="{Binding IsAwayDivision, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <TextBlock Text="{Binding AwayDivisionNote}" FontSize="12"
                                       Foreground="#CFE4FF" VerticalAlignment="Center" />
                            <Button Content="{Binding HomeDivisionLabel}" Command="{Binding GoHomeDivision}"
                                    AutomationProperties.Name="Back to my division"
                                    HorizontalAlignment="Right" Padding="12,5" FontSize="11" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,4,0,8">
                            <ItemsControl ItemsSource="{Binding Rankings}" ItemTemplate="{StaticResource RankRowTemplate}" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <local:PageHost Title="POUND-FOR-POUND" Subtitle="Ranked on what they have won, across every division"
                                Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=P4P}">
                    <ItemsControl ItemsSource="{Binding PoundForPound}" ItemTemplate="{StaticResource RankRowTemplate}" />
                </local:PageHost>

                <local:PageHost Title="HALL OF FAME" Subtitle="The retired greats of this world"
                                Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Hall}">
                    <ItemsControl ItemsSource="{Binding HallOfFame}" ItemTemplate="{StaticResource RankRowTemplate}" />
                </local:PageHost>

                <!-- ============ CHAMPIONS ============ -->
                <local:PageHost Title="CHAMPIONS" Subtitle="Every belt in every division"
                                Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Champions}">
                    <ItemsControl ItemsSource="{Binding Champions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <!-- The division name is a link through to that division's rankings. -->
                                    <Button Style="{StaticResource RowButton}" HorizontalAlignment="Left"
                                            AutomationProperties.Name="{Binding Division}"
                                            ToolTip="See this division's rankings"
                                            Command="{Binding DataContext.ViewDivisionCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Margin="18,16,18,8">
                                            <TextBlock Text="{Binding Division}" Style="{StaticResource Label}"
                                                       Foreground="{StaticResource Text}" />
                                            <TextBlock Text="›" Foreground="{StaticResource Accent}" FontSize="14"
                                                       Margin="7,-3,0,0" />
                                            <Border Style="{StaticResource Tag}" BorderBrush="{StaticResource GoldLine}"
                                                    Margin="10,0,0,0"
                                                    Visibility="{Binding Undisputed, Converter={StaticResource EmptyVis}}">
                                                <TextBlock Text="{Binding Undisputed}" Style="{StaticResource TagText}"
                                                           Foreground="{StaticResource Gold}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding Belts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowButton}"
                                                        AutomationProperties.Name="{Binding Holder}"
                                                        Command="{Binding DataContext.ShowFighter, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Border Margin="12,2" CornerRadius="8" Padding="8,6">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Lineal}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource GoldSoft}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="60" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Belt}" FontSize="9"
                                                                       FontWeight="Bold" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Lineal}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="1" Text="{Binding Holder}"
                                                                       FontSize="13.5" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Vacant}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                                                <Setter Property="FontWeight" Value="Normal" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                                       FontSize="11.5" Foreground="{StaticResource Muted}"
                                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </local:PageHost>

                <!-- ============ AWARDS ============ -->
                <Grid Margin="28,26,28,28"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Awards}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="AWARDS" FontSize="19" FontWeight="Light"
                                       Foreground="{StaticResource Text}" />
                            <TextBlock Text="{Binding AwardsSubtitle}" FontSize="12"
                                       Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox Width="200" ItemsSource="{Binding AwardCategories}"
                                      SelectedItem="{Binding AwardCategory}" />
                            <ComboBox Width="130" Margin="10,0,0,0" ItemsSource="{Binding AwardYears}"
                                      SelectedItem="{Binding AwardYear}" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,4,0,8">
                    <ItemsControl ItemsSource="{Binding Awards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="18,16,18,4">
                                    <TextBlock Style="{StaticResource Label}">
                                        <Run Text="{Binding Year, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Category, Mode=OneWay}" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Places}" Margin="0,9,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                              <Button Style="{StaticResource RowButton}" AutomationProperties.Name="{Binding Name}"
                                                      Command="{Binding DataContext.ShowAward, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}">
                                                <Border CornerRadius="10" Padding="13" Margin="0,0,9,9" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource Panel2}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Winner}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource GoldSoft}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldLine}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Position}" FontSize="9" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Winner}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                                                   Foreground="{StaticResource Text}" TextWrapping="Wrap"
                                                                   Margin="0,5,0,0" />
                                                        <TextBlock Text="{Binding Division}" FontSize="9" FontWeight="Bold"
                                                                   Foreground="{StaticResource Faint}" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                                   Margin="0,5,0,0" />
                                                        <TextBlock Text="read the citation ›" FontSize="10.5"
                                                                   Foreground="{StaticResource Accent}" Margin="0,7,0,0" />
                                                    </StackPanel>
                                                </Border>
                                              </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ============ NEWS ============ -->
                <local:PageHost Title="NEWS" Subtitle="Across the whole sport, most recent first"
                                Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=News}">
                    <ItemsControl ItemsSource="{Binding News}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="18,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Date}" FontSize="11" Foreground="{StaticResource Faint}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlayerBout}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </local:PageHost>

                <!-- ============ CAREER STATS ============ -->
                <local:PageHost Title="CAREER" Subtitle="What this fighter has done so far"
                                Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Stats}">
                    <ItemsControl ItemsSource="{Binding Stats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="9">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding Value}" FontSize="23" FontWeight="Light"
                                                   Foreground="{StaticResource Text}" Margin="0,7,0,0" />
                                        <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </local:PageHost>

                <!-- ============ ABOUT ============ -->
                <!-- The crowd recordings are CC-BY 4.0. That licence requires the credit to travel with the
                     audio, so it lives in the app and not only in the repository. If the audio in
                     assets/audio is replaced, this page has to be updated with it. -->
                <local:PageHost Title="ABOUT" Subtitle="What this is, and what it was built from"
                                Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=About}">
                    <StackPanel Margin="18,4,18,18" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="BoxingSim" FontSize="21" FontWeight="Light"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="A boxing career simulator. Fights are resolved round by round and called live; the world around you runs on whether you fight, so rankings, belts and reputations move on without you." />

                        <TextBlock Text="AUDIO" Style="{StaticResource Label}" Margin="0,26,0,0" />
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="The crowd, the bell and the punches are real recordings, excerpted and loop-treated for this app. Credit is due as follows." />

                        <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource Text}">
                                    <Run Text="Crowd beds and roar —" />
                                    <Run Text="&quot;Free Crowd Cheering Sounds&quot; by Gregor Quendel," FontWeight="SemiBold" />
                                    <Run Text="licensed CC BY 4.0. Modified: excerpted, level-matched and looped." />
                                </TextBlock>
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,4,0,0"
                                           Text="creativecommons.org/licenses/by/4.0/" />

                                <TextBlock FontSize="12.5" TextWrapping="Wrap" Margin="0,14,0,0"
                                           Foreground="{StaticResource Text}">
                                    <Run Text="Crowd &quot;ooh&quot;, punches and bell —" />
                                    <Run Text="sounds by rubberduck," FontWeight="SemiBold" />
                                    <Run Text="dedicated to the public domain under CC0 1.0. Modified: layered and enveloped." />
                                </TextBlock>
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,4,0,0"
                                           Text="opengameart.org  ·  creativecommons.org/publicdomain/zero/1.0/" />
                            </StackPanel>
                        </Border>

                        <TextBlock Foreground="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Text="If no audio files are present the app synthesises every layer instead, and none of the above applies." />
                    </StackPanel>
                </local:PageHost>
            </Grid>

            <!-- ============ FIGHT NIGHT ============ -->
            <!-- The fight takes the whole window and is CALLED, line by line, rather than tabulated. -->
            <Grid Grid.ColumnSpan="2" Panel.ZIndex="9"
                  Visibility="{Binding IsPlayingBack, Converter={StaticResource BoolVis}}">
                <Border Background="#F2050810" />
                <Grid Margin="0,26,0,26" MaxWidth="980">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="{Binding FightNightBillLine}" Style="{StaticResource Label}"
                                   HorizontalAlignment="Center" Foreground="{StaticResource Gold}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Right" Margin="0,0,26,0">
                                <TextBlock Text="{Binding FightNightHome}" FontSize="27" FontWeight="Light"
                                           Foreground="{StaticResource Text}" TextAlignment="Right" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding FightNightHomeRecord}" FontSize="13"
                                           Foreground="{StaticResource Muted}" TextAlignment="Right" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="vs" FontSize="15" Foreground="{StaticResource Faint}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Left" Margin="26,0,0,0">
                                <TextBlock Text="{Binding FightNightAway}" FontSize="27" FontWeight="Light"
                                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding FightNightAwayRecord}" FontSize="13"
                                           Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- The scoreboard MOVES with the call: round, clock, and each man's share of the
                             punches landed leaning against each other. Without something changing, a wall of
                             text has nothing to land against. -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding LiveMine}" FontSize="30" FontWeight="Light"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,18,0" />
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding LiveRound}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource Text}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding LiveClock}" FontSize="20" FontFamily="Consolas"
                                           Foreground="{StaticResource Gold}" HorizontalAlignment="Center"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="PUNCHES LANDED" FontSize="8.5" FontWeight="Bold"
                                           Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding LiveHis}" FontSize="30" FontWeight="Light"
                                       Foreground="{StaticResource Muted}" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="18,0,0,0" />
                        </Grid>

                        <Grid Margin="0,8,0,0" Height="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="MineShare">
                                <Border Background="{StaticResource Line}" CornerRadius="4" />
                                <Border HorizontalAlignment="Right" CornerRadius="4" Background="{StaticResource Accent}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource BarWidth}">
                                            <Binding Path="LiveMineShare" />
                                            <Binding Path="ActualWidth" ElementName="MineShare" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Grid>
                            <Grid x:Name="HisShare" Grid.Column="2">
                                <Border Background="{StaticResource Line}" CornerRadius="4" />
                                <Border HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource Line2}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource BarWidth}">
                                            <Binding Path="LiveHisShare" />
                                            <Binding Path="ActualWidth" ElementName="HisShare" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- A man in trouble is stated plainly, and stays stated while he is. -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HURT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Loss}"
                                       HorizontalAlignment="Right" Margin="0,0,18,0"
                                       Visibility="{Binding MyManHurt, Converter={StaticResource BoolVis}}" />
                            <TextBlock Grid.Column="1" Text="HURT" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Loss}" HorizontalAlignment="Left" Margin="18,0,0,0"
                                       Visibility="{Binding HisManHurt, Converter={StaticResource BoolVis}}" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Background="#0A0E15">
                        <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto" Padding="30,22,30,22"
                                      ScrollChanged="FeedScroll_ScrollChanged">
                            <!-- Bottom-aligned: with finished rounds folded away the call is short, and
                                 growing upward from a fixed point reads far better than floating in a void. -->
                            <ItemsControl ItemsSource="{Binding Rounds}" VerticalAlignment="Bottom">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <!-- The round heading doubles as the fold: click it to reopen a
                                                 round that has already been fought. -->
                                            <Button Style="{StaticResource RowButton}" HorizontalAlignment="Stretch"
                                                    AutomationProperties.Name="{Binding Title}"
                                                    Command="{Binding DataContext.ToggleRound, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Grid Margin="0,10,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                               Foreground="{StaticResource Accent}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12.5"
                                                               FontStyle="Italic" Foreground="{StaticResource Faint}"
                                                               Margin="14,2,0,0" TextWrapping="Wrap"
                                                               Visibility="{Binding HasSummary, Converter={StaticResource BoolVis}}" />
                                                </Grid>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,0,0,4"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Clock}" FontSize="11" FontFamily="Consolas"
                                                               Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                                               FontSize="14.5" Foreground="{StaticResource Muted}"
                                                               RenderTransformOrigin="0,0.5">
                                                        <TextBlock.RenderTransform>
                                                            <TranslateTransform x:Name="tt" X="0" />
                                                        </TextBlock.RenderTransform>
                                                        <TextBlock.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="0" To="1" Duration="0:0:0.22" />
                                                                        <DoubleAnimation Storyboard.TargetName="tt"
                                                                                         Storyboard.TargetProperty="X"
                                                                                         From="16" To="0" Duration="0:0:0.22">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </TextBlock.Triggers>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBig}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDrama}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                        <Setter Property="FontSize" Value="19" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsVerdict}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Win}" />
                                                                        <Setter Property="FontSize" Value="22" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                        <Setter Property="Margin" Value="0,8,0,8" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCorner}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Win}" />
                                                                        <Setter Property="FontSize" Value="13.5" />
                                                                        <Setter Property="Margin" Value="0,7,0,5" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCrowd}" Value="True">
                                                                        <Setter Property="Foreground" Value="#B08CFF" />
                                                                        <Setter Property="FontSize" Value="15" />
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPattern}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                                        <Setter Property="FontSize" Value="14" />
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                        <Setter Property="Margin" Value="0,6,0,4" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock Text="{Binding PlaybackVerdict}" FontSize="19" TextWrapping="Wrap"
                                   Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,0,0,14"
                                   Visibility="{Binding PlaybackFinished, Converter={StaticResource BoolVis}}" />
                        <!-- Watch it at your own pace: speed, pause, or jump to the end. Pausing lets the call
                             be scrolled back and read. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12"
                                    Visibility="{Binding PlaybackFinished, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <TextBlock Text="SPEED" Style="{StaticResource Label}" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Button Style="{StaticResource SpeedButton}" Content="0.5x" AutomationProperties.Name="Half speed"
                                    Command="{Binding SetSpeed}" CommandParameter="0.5"
                                    Tag="{Binding IsHalfSpeed, Converter={StaticResource OnOff}}" />
                            <Button Style="{StaticResource SpeedButton}" Content="1x" AutomationProperties.Name="Normal speed"
                                    Command="{Binding SetSpeed}" CommandParameter="1"
                                    Tag="{Binding IsNormalSpeed, Converter={StaticResource OnOff}}" />
                            <Button Style="{StaticResource SpeedButton}" Content="2x" AutomationProperties.Name="Double speed"
                                    Command="{Binding SetSpeed}" CommandParameter="2"
                                    Tag="{Binding IsDoubleSpeed, Converter={StaticResource OnOff}}" />
                            <Button Content="{Binding PauseLabel}" AutomationProperties.Name="{Binding PauseLabel}"
                                    Command="{Binding TogglePause}" Margin="14,0,0,0" Padding="18,7" FontSize="12" />
                            <Button Content="{Binding SoundLabel}" AutomationProperties.Name="{Binding SoundLabel}"
                                    Command="{Binding ToggleSound}" Margin="8,0,0,0" Padding="18,7" FontSize="12" />
                        </StackPanel>
                        <Button Command="{Binding FinishPlayback}" Style="{StaticResource PrimaryButton}"
                                Content="{Binding PlaybackButtonLabel}" Padding="30,12"
                                AutomationProperties.Name="{Binding PlaybackButtonLabel}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- A banner while the world is being simulated, so a pause is never silent. -->
            <Border Grid.ColumnSpan="2" Panel.ZIndex="20" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                    BorderThickness="1" CornerRadius="0,0,10,10" Padding="20,10"
                    Visibility="{Binding Busy, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding BusyMessage}" FontSize="12.5" Foreground="#CFE4FF" />
            </Border>

            <!-- ============ AWARD CITATION (overlay) ============ -->
            <Grid Grid.ColumnSpan="2" Panel.ZIndex="11"
                  Visibility="{Binding HasAward, Converter={StaticResource BoolVis}}">
                <Button Style="{StaticResource BackdropButton}" Command="{Binding CloseAward}"
                        AutomationProperties.Name="Close" />
                <Border Style="{StaticResource Card}" Width="560" Padding="0"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        DataContext="{Binding SelectedAward}">
                    <Grid>
                        <Button Style="{StaticResource CloseXButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="3"
                                AutomationProperties.Name="Close"
                                Command="{Binding DataContext.CloseAward, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <StackPanel Margin="24,22,24,22">
                            <TextBlock Text="{Binding Heading}" Style="{StaticResource Label}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Style="{StaticResource Tag}" BorderBrush="{StaticResource GoldLine}">
                                    <TextBlock Text="{Binding Position}" Style="{StaticResource TagText}"
                                               Foreground="{StaticResource Gold}" />
                                </Border>
                                <TextBlock Text="{Binding Division}" Style="{StaticResource TagText}"
                                           Foreground="{StaticResource Faint}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Light"
                                       Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,0"
                                    Visibility="{Binding HasCommentary, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding Commentary}" FontSize="13.5" LineHeight="21"
                                       Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,16,0,0"
                                       Visibility="{Binding HasCommentary, Converter={StaticResource BoolVis}}" />
                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="{Binding OpenFighterLabel}"
                                        AutomationProperties.Name="{Binding OpenFighterLabel}"
                                        Visibility="{Binding CanOpenFighter, Converter={StaticResource BoolVis}}"
                                        Command="{Binding DataContext.OpenAwardFighter, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Grid.Column="2" Content="Close  (Esc)" AutomationProperties.Name="Close"
                                        Padding="26,10"
                                        Command="{Binding DataContext.CloseAward, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ FIGHT DETAIL (overlay) ============ -->
            <Grid Grid.ColumnSpan="2" Panel.ZIndex="10"
                  Visibility="{Binding HasFight, Converter={StaticResource BoolVis}}">
                <Button Style="{StaticResource BackdropButton}" Command="{Binding CloseFight}"
                        AutomationProperties.Name="Close" />
                <Border Style="{StaticResource Card}" Width="700" MaxHeight="800" Padding="0"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        DataContext="{Binding SelectedFight}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button Style="{StaticResource CloseXButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="3"
                                AutomationProperties.Name="Close"
                                Command="{Binding DataContext.CloseFight, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <StackPanel Margin="24,22,24,14">
                            <TextBlock Text="{Binding Opponent}" FontSize="21" FontWeight="Light"
                                       Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Verdict}" FontSize="14" Margin="0,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Win}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Win}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Loss}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Loss}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="{Binding Date}" FontSize="11.5" Foreground="{StaticResource Faint}" />
                                <TextBlock Text="  ·  " FontSize="11.5" Foreground="{StaticResource Faint}"
                                           Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                                <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="{StaticResource Gold}"
                                           Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                            </StackPanel>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Totals for the bout -->
                                <ItemsControl ItemsSource="{Binding Totals}" Margin="16,0,16,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                                                    BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{StaticResource Faint}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Value}" FontSize="19" FontWeight="Light"
                                                               Foreground="{StaticResource Text}" Margin="0,5,0,0" />
                                                    <TextBlock Text="{Binding Note}" FontSize="10.5"
                                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding NoRoundsNote}" FontSize="12.5" Margin="24,14,24,14"
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                           Visibility="{Binding HasRounds, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />

                                <StackPanel Visibility="{Binding HasRounds, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="ROUND BY ROUND" Style="{StaticResource PanelHeader}" Margin="24,12,24,4" />
                                    <Grid Margin="24,0,24,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="RD" Style="{StaticResource TagText}" Foreground="{StaticResource Faint}" />
                                        <TextBlock Grid.Column="1" Text="SCORE" Style="{StaticResource TagText}" Foreground="{StaticResource Faint}" />
                                        <TextBlock Grid.Column="2" Text="SHARE OF PUNCHES LANDED" Style="{StaticResource TagText}" Foreground="{StaticResource Faint}" />
                                        <TextBlock Grid.Column="3" Text="LANDED" Style="{StaticResource TagText}" Foreground="{StaticResource Faint}" />
                                        <TextBlock Grid.Column="4" Text="KD" Style="{StaticResource TagText}" Foreground="{StaticResource Faint}" />
                                    </Grid>
                                    <!-- Bottom-aligned: with finished rounds folded away the call is short, and
                                 growing upward from a fixed point reads far better than floating in a void. -->
                            <ItemsControl ItemsSource="{Binding Rounds}" VerticalAlignment="Bottom">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="24,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="60" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Round}" FontSize="11.5"
                                                               Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Score}" FontSize="13.5"
                                                               FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding WonRound}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- How the round's punches split, at a glance. -->
                                                    <Grid x:Name="Track" Grid.Column="2" Height="8" VerticalAlignment="Center"
                                                          Margin="0,0,14,0">
                                                        <Border Background="{StaticResource Line}" CornerRadius="4" />
                                                        <Border HorizontalAlignment="Left" CornerRadius="4"
                                                                Background="{StaticResource Accent}">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource BarWidth}">
                                                                    <Binding Path="ShareFor" />
                                                                    <Binding Path="ActualWidth" ElementName="Track" />
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Grid.Column="3" Text="{Binding Landed}" FontSize="12"
                                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Knockdowns}" FontSize="12"
                                                               FontWeight="Bold" Foreground="{StaticResource Gold}"
                                                               VerticalAlignment="Center" />
                                                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="5" Margin="46,3,0,7"
                                                                  ItemsSource="{Binding Commentary}"
                                                                  Visibility="{Binding HasCommentary, Converter={StaticResource BoolVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                                           Margin="0,0,0,2">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Converter={StaticResource Shout}}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasCards, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="JUDGES" Style="{StaticResource PanelHeader}" Margin="24,14,24,4" />
                                    <TextBlock Text="{Binding Cards}" FontSize="13" Margin="24,0,24,4"
                                               Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasCommentary, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="OTHER NOTES" Style="{StaticResource PanelHeader}" Margin="24,14,24,4" />
                                    <ItemsControl ItemsSource="{Binding Commentary}" Margin="24,0,24,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{StaticResource Muted}" Margin="0,3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2" Content="Close  (Esc)" AutomationProperties.Name="Close" Margin="24,12,24,22"
                                Command="{Binding DataContext.CloseFight, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ FIGHTER CARD (overlay) ============ -->
            <Grid Grid.ColumnSpan="2"
                  Visibility="{Binding HasCard, Converter={StaticResource BoolVis}}">
                <Button Style="{StaticResource BackdropButton}" Command="{Binding CloseCard}"
                        AutomationProperties.Name="Close" />
                <Border Style="{StaticResource Card}" Width="620" MaxHeight="760" Padding="0"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        DataContext="{Binding SelectedCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button Style="{StaticResource CloseXButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="3"
                                AutomationProperties.Name="Close"
                                Command="{Binding DataContext.CloseCard, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Grid Margin="24,22,24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="12" Width="62" Height="48" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Class}" FontSize="24" FontWeight="Light"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Class, Converter={StaticResource ClassColour}}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Light"
                                           Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Record}" FontSize="13" Foreground="{StaticResource Muted}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource Faint}"
                                           Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Belts}" FontSize="11.5" Foreground="{StaticResource Gold}"
                                           Margin="0,5,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding Belts, Converter={StaticResource EmptyVis}}" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="ATTRIBUTES · 1–15" Style="{StaticResource PanelHeader}" Margin="24,4,24,8"
                                           Visibility="{Binding HasRatings, Converter={StaticResource BoolVis}}" />
                                <ItemsControl ItemsSource="{Binding Ratings}" Margin="24,0,24,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,14,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="98" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Muted}" />
                                                <Grid x:Name="Track" Grid.Column="1" Height="7" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource Line}" CornerRadius="3.5" />
                                                    <Border HorizontalAlignment="Left" CornerRadius="3.5"
                                                            Background="{StaticResource Accent}">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource BarWidth}">
                                                                <Binding Path="Width" />
                                                                <Binding Path="ActualWidth" ElementName="Track" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="RECENT BOUTS" Style="{StaticResource PanelHeader}" Margin="24,10,24,4" />
                                <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource LedgerRowTemplate}"
                                              Margin="6,0,6,8" />
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="24,12,24,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Follow him to his own division rather than closing and hunting for it. -->
                            <Button Content="{Binding DivisionLink}" AutomationProperties.Name="{Binding DivisionLink}"
                                    Visibility="{Binding HasDivisionLink, Converter={StaticResource BoolVis}}"
                                    Command="{Binding DataContext.ViewDivisionCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Division}" />
                            <Button Grid.Column="2" Content="Close  (Esc)" AutomationProperties.Name="Close" Padding="26,10"
                                    Command="{Binding DataContext.CloseCard, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
