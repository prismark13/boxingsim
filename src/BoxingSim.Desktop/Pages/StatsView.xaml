<UserControl x:Class="BoxingSim.Desktop.Pages.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BoxingSim.Desktop">
    <local:PageHost Title="CAREER" Subtitle="What this fighter has done so far">
      <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ItemsControl ItemsSource="{Binding Stats}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="9">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Value}" FontSize="21" FontWeight="Light"
                                       Foreground="{StaticResource Text}" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource Muted}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Moving up lives here rather than under tonight's opponent. It is a career decision made
             once or twice in a career, not a thing to weigh while looking at a fight you have
             already agreed to, and it was a full-width bar on the busiest page in the app.

             Its three bindings deliberately reach the SHELL rather than this page's view-model. Moving up
             changes the world and has to refresh every page, and whether it is allowed depends on whether a
             fight has been agreed — which is camp state. Neither belongs to a page of tiles, so neither moved
             here; the panel just happens to be drawn on this page. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,16" Margin="9,14,9,4"
                Visibility="{Binding DataContext.MoveUpLabel, RelativeSource={RelativeSource AncestorType=Window},
                             Converter={StaticResource EmptyVis}}">
            <StackPanel>
                <TextBlock Text="CHANGING DIVISION" Style="{StaticResource Label}" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Text="Heavier men hit harder, and the ranking you have built here does not travel with you. You cannot move while a fight is agreed." />
                <Button Content="{Binding DataContext.MoveUpLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.MoveUp, RelativeSource={RelativeSource AncestorType=Window}}"
                        HorizontalAlignment="Left" Margin="0,14,0,0" Padding="16,9" FontSize="13"
                        IsEnabled="{Binding DataContext.FightIsStillAnOffer, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Border>
      </Grid>
    </local:PageHost>
</UserControl>
