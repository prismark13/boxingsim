<UserControl x:Class="BoxingSim.Desktop.Pages.AwardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,26,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="2,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AWARDS" FontSize="18" FontWeight="Light"
                           Foreground="{StaticResource Text}" />
                <TextBlock Text="{Binding AwardsSubtitle}" FontSize="12"
                           Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox Width="200" ItemsSource="{Binding AwardCategories}"
                          SelectedItem="{Binding AwardCategory}" />
                <ComboBox Width="130" Margin="10,0,0,0" ItemsSource="{Binding AwardYears}"
                          SelectedItem="{Binding AwardYear}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,4,0,8">
        <ItemsControl ItemsSource="{Binding Awards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="18,16,18,4">
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="{Binding Year, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Category, Mode=OneWay}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Places}" Margin="0,9,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Button Style="{StaticResource RowButton}" AutomationProperties.Name="{Binding Name}"
                                          Command="{Binding DataContext.ShowAward, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}">
                                    <Border CornerRadius="10" Padding="13" Margin="0,0,9,9" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Panel2}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Winner}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GoldSoft}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource GoldLine}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Position}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Winner}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource Text}" TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding Division}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource Faint}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                            <TextBlock Text="read the citation ›" FontSize="11"
                                                       Foreground="{StaticResource Quiet}" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Border>
                                  </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
