<!-- Fight night, and the weeks that lead to it.

     NO DataContext override, deliberately. This page is the shell's camp state end to end — the offer, the
     countdown, the build-up feed, the poster, the tape and the result banner are all read and written by
     Take(), the step gate and the playback loop, none of which are page concerns. Letting the control inherit
     the window's DataContext means every binding in here resolves exactly as it did when this markup lived in
     MainWindow, so moving it could not change behaviour.

     A real CampViewModel is worth doing, but it means moving the camp state machine, and that wants an app
     you can actually run to check it against. -->
<UserControl x:Class="BoxingSim.Desktop.Pages.CampView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BoxingSim.Desktop"
             xmlns:pages="clr-namespace:BoxingSim.Desktop.Pages">
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- THE BUILD-UP, above the poster rather than below it, and OUTSIDE the scroller.

                 It used to sit under the bill, which on any normal window put the countdown and
                 the Continue button below the fold — so pressing "go to fight night" landed you on
                 a page where the one thing you now had to press was off screen. Moving it to the top
                 of the page only half-fixed that: it was still the first thing INSIDE the scrolling
                 body, so reading down the week's news carried it off the top instead. Every "the
                 button is missing" report was this, not the state machine. It is pinned now, so the
                 one thing you can do is on screen no matter where the feed is scrolled to. -->
            <!-- Time passes. Everything the sport did between his fights used to happen in
                 the single frame between clicking "take the fight" and the opening bell.
                 There was a "Wait for fight night" button here as well, which did what "Go to
                 fight night" now does from the same page - two buttons for one action. -->
            <!-- Held between weeks, so the build-up can be read rather than watched going
                 past. "Run the rest" hands the pacing back to the clock for this one run. -->
            <!-- The margins and MaxWidth are the scrolling body's own (28 + an inner 24, capped at
                 1000) worked out one level up, so the row sits over the column rather than beside it. -->
            <Grid Grid.Row="0" Margin="52,22,52,0" MaxWidth="952" HorizontalAlignment="Stretch"
                  Visibility="{Binding ShowCampActions, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Accepting, here as well as on Home. This page shows a countdown whether or not
                     the fight has been taken, and a countdown with no button under it is a dead
                     end — which is what it was. -->
                <Button Content="Accept fight" Command="{Binding TakeFight}"
                        Style="{StaticResource PrimaryButton}" Padding="14,10" FontSize="13"
                        ToolTip="{Binding TakeFightHint}"
                        Visibility="{Binding FightIsStillAnOffer, Converter={StaticResource BoolVis}}" />
                <!-- The walk-out. Once the date has come there are no weeks left to run, so
                     Continue goes and this takes its place in the same spot. -->
                <Button Content="Fight now" Command="{Binding TakeFight}"
                        Style="{StaticResource PrimaryButton}" Padding="14,10" FontSize="13"
                        ToolTip="The date has come — first bell"
                        Visibility="{Binding ReadyToFight, Converter={StaticResource BoolVis}}" />
                <Button Content="Continue" Command="{Binding StepForward}"
                        Style="{StaticResource PrimaryButton}" Padding="14,10" FontSize="13"
                        ToolTip="One more week"
                        Visibility="{Binding InCamp, Converter={StaticResource BoolVis}}" />
                <Button Grid.Column="2" Content="Go to fight night" Command="{Binding RunTheRest}"
                        Padding="14,10" FontSize="13"
                        ToolTip="Run the remaining weeks straight through to the first bell"
                        Visibility="{Binding InCamp, Converter={StaticResource BoolVis}}" />
                <Button Grid.Column="2" Content="Turn it down" Command="{Binding HoldOut}"
                        Padding="14,10" FontSize="13"
                        ToolTip="Refuse this fight and wait for another offer"
                        Visibility="{Binding FightIsStillAnOffer, Converter={StaticResource BoolVis}}" />

            </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,26,28,28" MaxWidth="1000" HorizontalAlignment="Stretch">

                <!-- The fights on the table. See Pages/OfferSlateView.xaml. -->
                <pages:OfferSlateView DataContext="{Binding OfferSlate}" />

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="10" Margin="24,0,24,12" Padding="16,12"
                        Visibility="{Binding ShowCamp, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CampCountdown}" Style="{StaticResource Label}"
                                       Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding CampDate}" FontSize="12"
                                       Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- A fight in his own division worth stopping for. The round-by-round is
                             already stored for these, so it can actually be watched. -->
                        <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                                BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,10,0,0"
                                Visibility="{Binding HasTheOne, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="IN YOUR DIVISION, TONIGHT" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                    <TextBlock Text="{Binding TheOne}" FontSize="15"
                                               Foreground="{StaticResource Text}" Margin="0,3,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <!-- Two answers, because there are two. Offering only "Watch it" left no way
                                     to decline it: the result was being held back from the feed for a fight
                                     the player might never open, so saying no had to be sayable. Either
                                     answer settles it and the feed gives up the result. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Command="{Binding WatchTheOne}" Style="{StaticResource PrimaryButton}"
                                            Padding="14,7" AutomationProperties.Name="Watch it"
                                            ToolTip="Watch the fight, round by round">
                                        <TextBlock><Run Text="✓" FontSize="14" /><Run Text="  Watch it" /></TextBlock>
                                    </Button>
                                    <Button Command="{Binding SkipTheOne}" Padding="14,7" Margin="8,0,0,0"
                                            AutomationProperties.Name="Don't watch it"
                                            ToolTip="Skip it — the result goes into the feed">
                                        <TextBlock><Run Text="✗" FontSize="14" /><Run Text="  Not tonight" /></TextBlock>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Taller than it was. This is the main thing on the page while the
                             weeks run — the sport happening on the way to your fight — not a
                             footnote under the poster. -->
                        <!-- Something to do with the wall of text. Twelve divisions reporting over four
                             months buries the one fight that concerns him among fifty that do not. -->
                        <Grid Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SHOWING" Style="{StaticResource Label}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox ItemsSource="{Binding DetailChoices}"
                                          SelectedItem="{Binding SelectedDetail}"
                                          MinWidth="150" VerticalAlignment="Center"
                                          AutomationProperties.Name="Level of detail"
                                          ToolTip="{Binding SelectedDetail.Explains}" />
                                <CheckBox Content="My weight only" IsChecked="{Binding CampMineOnly}"
                                          VerticalAlignment="Center" FontSize="12" Margin="16,0,0,0"
                                          ToolTip="Narrow whichever level you have chosen to your own division" />
                            </StackPanel>
                            <TextBlock Text="{Binding CampCountLabel}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource Faint}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Camp}" Margin="0,8,0,0" MaxHeight="420">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- The ones worth raising your eyes for are drawn like it: a belt
                                         changing hands, a boilover, or anything in his own weight.
                                         The rest is weather and stays quiet. -->
                                    <Border Margin="0,1" Padding="8,4" CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Major}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Panel2}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Date}" FontSize="11"
                                                       Foreground="{StaticResource Faint}" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Major}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PlayerBout}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,3,0,0"
                                                           TextWrapping="Wrap" Foreground="{StaticResource Faint}"
                                                           Visibility="{Binding Detail, Converter={StaticResource EmptyVis}}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="4" Padding="6,1" Margin="10,1,0,0"
                                                    VerticalAlignment="Top" BorderThickness="1"
                                                    Visibility="{Binding HasTag, Converter={StaticResource BoolVis}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTitle}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource GoldSoft}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource GoldLine}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTitle}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Hidden while the playback overlay is up: showing the verdict behind it gives the
                     result away before the rounds have been watched. -->
                <Border Style="{StaticResource Card}" Padding="20,15" Margin="0,0,0,16"
                        Visibility="{Binding ShowResultBanner, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding ResultHeadline}" FontSize="15" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastBoutWon}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Win}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LastBoutLost}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Loss}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- The fight, as a poster -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16"
                        Visibility="{Binding HasOffer, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <Border Background="#12100D" CornerRadius="14,14,0,0" Padding="24,16">
                            <TextBlock Style="{StaticResource Label}">
                                <Run Text="FIGHT NIGHT · " /><Run Text="{Binding OfferDateLabel, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding OfferContext, Mode=OneWay}" />
                            </TextBlock>
                        </Border>

                        <Grid Margin="24,22,24,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PlayerHeadline}" FontSize="21" FontWeight="Light"
                                           Foreground="{StaticResource Text}" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock Text="{Binding PlayerRecord}" FontSize="13"
                                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="{Binding PlayerIdentity}" FontSize="11"
                                           Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="{Binding PlayerFrame}" FontSize="11"
                                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center"
                                           Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                <!-- What he DOES, not just what he is. -->
                                <TextBlock Text="{Binding PlayerOutput}" FontSize="11"
                                           Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                           Margin="0,3,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                           Visibility="{Binding PlayerOutput, Converter={StaticResource EmptyVis}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="vs" FontSize="15" Foreground="{StaticResource Faint}"
                                       VerticalAlignment="Center" Margin="24,0" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Button Style="{StaticResource RowButton}" Padding="0"
                                        AutomationProperties.Name="{Binding OfferOpponent}"
                                        ToolTip="See his card"
                                        Command="{Binding DataContext.ShowFighter, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding OfferOpponentFighter}">
                                <TextBlock Text="{Binding OfferOpponent}" FontSize="21" FontWeight="Light"
                                           Foreground="{StaticResource Text}" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                                </Button>
                                <TextBlock Text="{Binding OfferOpponentRecord}" FontSize="13"
                                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="{Binding OfferOpponentMeta}" FontSize="11"
                                           Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="{Binding OfferOpponentFrame}" FontSize="11"
                                           Foreground="{StaticResource Foe}" HorizontalAlignment="Center"
                                           Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding OfferOpponentOutput}" FontSize="11"
                                           Foreground="{StaticResource Faint}" HorizontalAlignment="Center"
                                           Margin="0,3,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                           Visibility="{Binding OfferOpponentOutput, Converter={StaticResource EmptyVis}}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding OfferRounds}" FontSize="12" Foreground="{StaticResource Faint}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />

                        <!-- Styles make fights, so they go above the numbers. -->
                        <Grid Margin="24,18,24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding MyStyle}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}" TextAlignment="Right" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="vs" FontSize="11" Margin="12,0"
                                       Foreground="{StaticResource Faint}" />
                            <TextBlock Grid.Column="2" Text="{Binding TheirStyle}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="{Binding StyleRead}" FontSize="12" Margin="24,6,24,0"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" />

                        <!-- The tape, in three groups inside a section that folds away.

                             Seven bars in a row with the name down the middle gave the eye
                             nowhere to rest and no reason for the order. Each group now
                             answers one question, and the whole thing collapses — its header
                             says who the numbers favour, so folding it loses nothing. -->
                        <Expander Style="{StaticResource Section}" Margin="24,14,24,0"
                                  IsExpanded="{Binding FightIsStillAnOffer, Mode=OneWay}" Header="TALE OF THE TAPE · 1–15"
                                  Tag="{Binding TapeEdge}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Whose column is whose, said rather than inferred from the colours. -->
                                    <TextBlock Text="YOU" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"
                                               Foreground="{StaticResource Accent}" />
                                    <TextBlock Grid.Column="2" Text="{Binding OfferOpponent}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{StaticResource Foe}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Text="WHAT HE HITS WITH" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Quiet}" Margin="0,10,0,4"
                                           HorizontalAlignment="Center" />
                                <ItemsControl ItemsSource="{Binding TapeAttack}"
                                              ItemTemplate="{StaticResource TapeRowTemplate}" />
                                <TextBlock Text="WHAT HE CAN TAKE" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Quiet}" Margin="0,10,0,4"
                                           HorizontalAlignment="Center" />
                                <ItemsControl ItemsSource="{Binding TapeDefence}"
                                              ItemTemplate="{StaticResource TapeRowTemplate}" />
                                <TextBlock Text="THE ENGINE" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Quiet}" Margin="0,10,0,4"
                                           HorizontalAlignment="Center" />
                                <ItemsControl ItemsSource="{Binding TapeEngine}"
                                              ItemTemplate="{StaticResource TapeRowTemplate}" />
                            </StackPanel>
                        </Expander>

                        <!-- The bill, as a poster. A card is a thing you read BEFORE the night: what
                             kind of show it is, which hall, who else is on, and where you come on it. -->
                        <Expander Style="{StaticResource Section}" Margin="24,10,24,0"
                                  IsExpanded="{Binding FightIsStillAnOffer, Mode=OneWay}" Header="THE CARD"
                                  Tag="{Binding BillHeader}"
                                  Visibility="{Binding HasBill, Converter={StaticResource BoolVis}}">
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource GoldLine}"
                                BorderThickness="1" CornerRadius="10" Margin="0,0,0,12" Padding="18,14">
                            <StackPanel>
                                <!-- The venue line is the section's summary now, so it is not repeated
                                     here as well. -->
                                <TextBlock Text="{Binding CardNote}" FontSize="13" Margin="0,0,0,12"
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                           TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" />
                                <ItemsControl ItemsSource="{Binding Bill}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2" CornerRadius="6" Padding="10,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <!-- A bill line reads like a bill: each corner with his
                                                     country and his record under his name, and a gold
                                                     TITLE mark on the one with a belt on it. "A vs B"
                                                     on its own told you nothing about either man,
                                                     which across seven unfamiliar undercard names is
                                                     no information at all. -->
                                                <StackPanel>
                                                <!-- Where this bout sits on the poster. The card is
                                                     listed main event first and BOXED from the foot
                                                     upward, so naming the places is what makes the
                                                     order legible rather than arbitrary. -->
                                                <TextBlock Text="{Binding Slot}" FontSize="10"
                                                           FontWeight="Bold" Margin="0,0,0,3"
                                                           Foreground="{StaticResource Faint}"
                                                           Visibility="{Binding HasSlot, Converter={StaticResource BoolVis}}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AName}" FontSize="13"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" Foreground="{StaticResource Faint}"
                                                                   Margin="0,2,0,0" TextWrapping="Wrap">
                                                            <Run Text="{Binding ACountry, Mode=OneWay, Converter={StaticResource Ctry}}" /><Run Text="  ·  " /><Run Text="{Binding ARecord, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="vs" FontSize="11"
                                                               Margin="14,1,14,0" VerticalAlignment="Top"
                                                               Foreground="{StaticResource Faint}" />

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding BName}" FontSize="13"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" Foreground="{StaticResource Faint}"
                                                                   Margin="0,2,0,0" TextWrapping="Wrap">
                                                            <Run Text="{Binding BCountry, Mode=OneWay, Converter={StaticResource Ctry}}" /><Run Text="  ·  " /><Run Text="{Binding BRecord, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Margin="14,0,0,0"
                                                                VerticalAlignment="Top">
                                                        <!-- The belt on the line, said plainly. The
                                                             header above only says the night has a
                                                             title on it, never which bout carries it. -->
                                                        <Border Background="{StaticResource GoldSoft}"
                                                                BorderBrush="{StaticResource GoldLine}"
                                                                BorderThickness="1" CornerRadius="4"
                                                                Padding="6,1" Margin="0,0,0,4"
                                                                HorizontalAlignment="Right"
                                                                Visibility="{Binding IsTitle, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="{Binding What, Converter={StaticResource Upper}}"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       Foreground="{StaticResource Gold}" />
                                                        </Border>
                                                        <!-- The weight it is made at. A bill spans the
                                                             divisions now, so which one this is
                                                             matters as much as the distance. -->
                                                        <TextBlock Text="{Binding DivName}" FontSize="11"
                                                                   Foreground="{StaticResource Faint}" TextAlignment="Right" />
                                                        <TextBlock Text="{Binding Distance}" FontSize="11"
                                                                   Foreground="{StaticResource Faint}" TextAlignment="Right"
                                                                   Visibility="{Binding Fought, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                                        <TextBlock Text="{Binding Verdict}" FontSize="12"
                                                                   Foreground="{StaticResource Muted}" TextAlignment="Right"
                                                                   Visibility="{Binding Fought, Converter={StaticResource BoolVis}}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="4"
                                                               Text="{Binding Note}" FontSize="12"
                                                               Foreground="{StaticResource Faint}" Margin="0,5,0,0"
                                                               TextWrapping="Wrap" FontStyle="Italic"
                                                               Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                                                </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        </Expander>


                        <!-- No accept or refuse here. Home is where a fight is taken or turned down;
                             this page is the fight you already took. -->
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16"
                        Visibility="{Binding PlayerRetired, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="This career is over. Start a new one to fight again."
                               Foreground="{StaticResource Muted}" FontSize="13" />
                </Border>

                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasLedger, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="FIGHT RECORD" Style="{StaticResource PanelHeader}" />
                        <ItemsControl ItemsSource="{Binding Ledger}" ItemTemplate="{StaticResource LedgerRowTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
