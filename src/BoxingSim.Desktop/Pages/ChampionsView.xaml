<UserControl x:Class="BoxingSim.Desktop.Pages.ChampionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BoxingSim.Desktop">
    <Grid>
    <local:PageHost Title="CHAMPIONS" Subtitle="Every belt in every division">
        <ItemsControl ItemsSource="{Binding Champions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,8">
                        <!-- The division name is a link through to that division's rankings. -->
                        <Button Style="{StaticResource RowButton}" HorizontalAlignment="Left"
                                AutomationProperties.Name="{Binding Division}"
                                ToolTip="See this division's rankings"
                                Command="{Binding DataContext.ViewDivisionCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Margin="18,16,18,8">
                                <TextBlock Text="{Binding Division}" Style="{StaticResource Label}"
                                           Foreground="{StaticResource Text}" />
                                <TextBlock Text="›" Foreground="{StaticResource Accent}" FontSize="15"
                                           Margin="7,-3,0,0" />
                                <Border Style="{StaticResource Tag}" BorderBrush="{StaticResource GoldLine}"
                                        Margin="10,0,0,0"
                                        Visibility="{Binding Undisputed, Converter={StaticResource EmptyVis}}">
                                    <TextBlock Text="{Binding Undisputed}" Style="{StaticResource TagText}"
                                               Foreground="{StaticResource Gold}" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Belts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}"
                                            AutomationProperties.Name="{Binding Holder}"
                                            Command="{Binding DataContext.ShowFighter, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Border Margin="12,2" CornerRadius="8" Padding="8,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Lineal}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource GoldSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Belt}" FontSize="11"
                                                           FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Lineal}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Holder}"
                                                           FontSize="13" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Vacant}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Detail}" FontSize="12"
                                                               Foreground="{StaticResource Muted}"
                                                               VerticalAlignment="Center" />
                                                    <!-- Through to who held it before him. Asked while looking
                                                         at who holds it now, which is why it lives here rather
                                                         than on a page of its own. -->
                                                    <Button Style="{StaticResource LinkName}" Content="history ›"
                                                            Margin="12,0,0,0" FontSize="11"
                                                            AutomationProperties.Name="The line of succession"
                                                            ToolTip="Every man who has held this belt"
                                                            Command="{Binding DataContext.ChampionsPage.ShowLineage, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </local:PageHost>
    <!-- THE LINE OF SUCCESSION, over the board rather than beside it: it is a drill-down, and the board
         behind it is the context you came from. -->
    <Border Panel.ZIndex="30" Background="#CC000000"
            Visibility="{Binding ShowingLineage, Converter={StaticResource BoolVis}}">
        <Border Style="{StaticResource Card}" Width="620" MaxHeight="640" Padding="0"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="22,18,18,12">
                    <StackPanel>
                        <TextBlock Text="{Binding LineageTitle}" FontSize="17"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding LineageSubtitle}" FontSize="12"
                                   Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,4"
                            FontSize="13" AutomationProperties.Name="Close"
                            Command="{Binding CloseLineage}" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding Lineage}" Margin="22,0,22,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,6"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Panel}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource GoldSoft}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldLine}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Holder}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text}" />
                                            <TextBlock Text="{Binding Where}" FontSize="11" Margin="10,2,0,0"
                                                       Foreground="{StaticResource Faint}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Span}" FontSize="12" Margin="0,3,0,0"
                                                   Foreground="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding How}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{StaticResource Faint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Border>
    </Grid>
</UserControl>