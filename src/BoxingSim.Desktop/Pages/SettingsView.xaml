<!-- Only presentation lives here. Nothing on this page changes how a fight is scored or how the world
     behaves — these decide how much of it you are made to sit through, which is a matter of taste and not of
     difficulty. Each is written to disk the moment it is toggled.

     The four toggles bind to the SHELL and deliberately have no view-model of their own. They are
     preferences: camp pacing reads them, the playback bar reads the sound one, and the fight button's own
     label changes with the first. State that four places read does not belong to the page that happens to
     draw the checkboxes. -->
<UserControl x:Class="BoxingSim.Desktop.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BoxingSim.Desktop">
    <local:PageHost Title="SETTINGS" Subtitle="How much of the night you want to watch">
        <StackPanel Margin="18,4,18,18" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="THE BUILD-UP" Style="{StaticResource Label}" />

            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                <StackPanel>
                    <CheckBox Content="Run the weeks to fight night" IsChecked="{Binding DataContext.FightWeek, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,7,0,0"
                               Text="Taking a fight runs the months between signing and the opening bell in front of you, with the sport carrying on as they pass — and it stops if something in your own division is worth watching. Turn this off and a fight begins the moment you accept it." />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                <StackPanel>
                    <CheckBox Content="Fight the undercard before your bout" IsChecked="{Binding DataContext.LiveUndercard, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,7,0,0"
                               Text="The supporting bouts land one at a time on the night, with a line on each, before you walk out. They are fought either way — this only decides whether you see them happen or read them afterwards. You can skip ahead at any point." />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                <StackPanel>
                    <CheckBox Content="Wait for me between weeks and bouts" IsChecked="{Binding DataContext.StepByStep, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,7,0,0"
                               Text="The build-up holds until you press Continue, rather than advancing on a timer. Turn this off and it runs itself — a week roughly every half second, a bout on the card every second or so. Either way you can hand the pacing back to the clock for a single night with &quot;Run the rest&quot;." />
                </StackPanel>
            </Border>

            <TextBlock Text="SOUND" Style="{StaticResource Label}" Margin="0,26,0,0" />

            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                <StackPanel>
                    <CheckBox Content="Crowd, bell and punches" IsChecked="{Binding DataContext.SoundEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,7,0,0"
                               Text="The same switch as the one on the playback bar. It is remembered between sessions now, along with the speed you last watched a fight at." />
                </StackPanel>
            </Border>

            <TextBlock FontSize="12" Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                       Margin="0,22,0,0"
                       Text="Kept in settings.json beside your save, not in the save itself — so they are yours rather than a given fighter's, and they survive abandoning a career." />
        </StackPanel>
    </local:PageHost>
</UserControl>
