<!-- The crowd recordings are CC-BY 4.0. That licence requires the credit to travel with the audio, so it
     lives in the app and not only in the repository. If the audio in assets/audio is replaced, this page has
     to be updated with it.

     No view-model: every word on this page is fixed at build time. -->
<UserControl x:Class="BoxingSim.Desktop.Pages.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BoxingSim.Desktop">
    <local:PageHost Title="ABOUT" Subtitle="What this is, and what it was built from">
        <StackPanel Margin="18,4,18,18" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="The Final Bell" FontSize="21" FontWeight="Light"
                       Foreground="{StaticResource Text}" />
            <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Text="A boxing career simulator. Fights are resolved round by round and called live; the world around you runs on whether you fight, so rankings, belts and reputations move on without you." />

            <TextBlock Text="AUDIO" Style="{StaticResource Label}" Margin="0,26,0,0" />
            <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Text="The crowd, the bell and the punches are real recordings, excerpted and loop-treated for this app. Credit is due as follows." />

            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource Text}">
                        <Run Text="Crowd beds and roar —" />
                        <Run Text="&quot;Free Crowd Cheering Sounds&quot; by Gregor Quendel," FontWeight="SemiBold" />
                        <Run Text="licensed CC BY 4.0. Modified: excerpted, level-matched and looped." />
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{StaticResource Faint}" Margin="0,4,0,0"
                               Text="creativecommons.org/licenses/by/4.0/" />

                    <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"
                               Foreground="{StaticResource Text}">
                        <Run Text="Crowd &quot;ooh&quot;, punches and bell —" />
                        <Run Text="sounds by rubberduck," FontWeight="SemiBold" />
                        <Run Text="dedicated to the public domain under CC0 1.0. Modified: layered and enveloped." />
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{StaticResource Faint}" Margin="0,4,0,0"
                               Text="opengameart.org  ·  creativecommons.org/publicdomain/zero/1.0/" />
                </StackPanel>
            </Border>

            <TextBlock Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Text="If no audio files are present the app synthesises every layer instead, and none of the above applies." />
        </StackPanel>
    </local:PageHost>
</UserControl>
